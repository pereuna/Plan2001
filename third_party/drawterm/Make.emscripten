# Emscripten: drawterm.js + drawterm.wasm for the browser (Monolith).
# pthreads (kprocs) need SharedArrayBuffer, i.e. COOP/COEP headers from
# the server.  Sockets are real blocking POSIX sockets, run by Emscripten's
# websocket_to_posix_proxy (tools/serve) on the page's behalf.
# getcallerpc() (lock debugging only) is 0: __builtin_return_address would
# need -sUSE_OFFSET_CONVERTER, which is slow on every lock.  main is
# gui-web/bridge.c's, which opens the socket bridge and calls drawterm's,
# and bridge.c works around getsockname and getpeername in Emscripten 3.1.69.
PTHREAD=-pthread
AR=emar
AS=emcc
RANLIB=emranlib
CC=emcc
CFLAGS=-Wall -Wno-missing-braces -Wno-parentheses -Wno-unused-but-set-variable -g -I$(ROOT) -I$(ROOT)/include -I$(ROOT)/kern -c -Dlinux -D_THREAD_SAFE -DPTHREAD $(PTHREAD) -D_REENTRANT '-D__builtin_return_address(x)=0' -Dmain=drawtermmain -Dgetsockname=monolithgetsockname -Dgetpeername=monolithgetpeername -O2
O=o
OS=posix
GUI=web
AUDIO=none
LDADD=-lwebsocket.js -sPROXY_POSIX_SOCKETS -sPROXY_TO_PTHREAD -sPTHREAD_POOL_SIZE=24 \
	-sSTACK_SIZE=1MB -sDEFAULT_PTHREAD_STACK_SIZE=1MB -sALLOW_MEMORY_GROWTH \
	-sEXIT_RUNTIME -sENVIRONMENT=web,worker \
	-sEXPORTED_RUNTIME_METHODS=ENV
LDFLAGS=$(PTHREAD)
TARG=drawterm.js

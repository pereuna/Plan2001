# Emscripten: drawterm.js + drawterm.wasm for the browser (Monolith).
# pthreads (kprocs) need SharedArrayBuffer, i.e. COOP/COEP headers from
# the server.  drawterm's TCP connections are WebSockets to Plan2001's
# webterm (gui-web/wsock.c; socket, connect, send, recv, close ... renamed).
# getcallerpc() (lock debugging only) is 0: __builtin_return_address would
# need -sUSE_OFFSET_CONVERTER, which is slow on every lock.  posix-factotum.c
# #undefs socket and calls it undeclared (a local factotum, unused here).
PTHREAD=-pthread
AR=emar
AS=emcc
RANLIB=emranlib
CC=emcc
CFLAGS=-Wall -Wno-missing-braces -Wno-parentheses -Wno-unused-but-set-variable -Wno-implicit-function-declaration -g -I$(ROOT) -I$(ROOT)/include -I$(ROOT)/kern -c -Dlinux -D_THREAD_SAFE -DPTHREAD $(PTHREAD) -D_REENTRANT '-D__builtin_return_address(x)=0' -Dsocket=wssocket -Dconnect=wsconnect -Dsend=wssend -Drecv=wsrecv -Dclose=wsclose -Dsetsockopt=wssetsockopt -Dgetsockname=wsgetsockname -Dgetpeername=wsgetpeername -O2
O=o
OS=posix
GUI=web
AUDIO=none
LDADD=-sPROXY_TO_PTHREAD -sPTHREAD_POOL_SIZE=24 \
	-sSTACK_SIZE=1MB -sDEFAULT_PTHREAD_STACK_SIZE=1MB -sALLOW_MEMORY_GROWTH \
	-sEXIT_RUNTIME -sENVIRONMENT=web,worker \
	-sEXPORTED_RUNTIME_METHODS=ENV,UTF8ToString -sEXPORTED_FUNCTIONS=_main,_malloc,_free
LDFLAGS=$(PTHREAD)
TARG=drawterm.js

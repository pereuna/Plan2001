#!/amd64/bin/rc
# Plan2001's init: the kernel mounted this root and runs this
# (docs/init.md, docs/selfhost.md).  The devices, the line editor on the
# console (console=N: the serial port) and its keyboard map (kbmap=fi:
# /sys/lib/kbmap/fi), the time zone, the mount points, the network if
# plan9.ini asks for it (ip=dhcp, or ip/ipconfig's arguments; then cs,
# dns, webfs), the kernel tests if plan9.ini has ktest=... (ktest's
# arguments), then rc.
rfork e
/$cputype/bin/bind /$cputype/bin /bin
bind -a /rc/bin /bin
path=(/bin .)
objtype=$cputype
# plan9.ini tz=EET: /adm/timezone/EET (default GMT)
if(~ $#tz 0 || ! test -r /adm/timezone/$tz)
	tz=GMT
cat /adm/timezone/$tz >/env/timezone
if(~ $#sysname 0)
	sysname=plan2001
for(i in ¤ ¶ P S f æ t b m)
	bind -qa '#'^$i /dev
a=()
if(! ~ $#console 0)
	a=/dev/eia^$console(1)
aux/kbdfs -q -s cons $a
if(! ~ $#kbmap 0 && test -r /sys/lib/kbmap/$kbmap)
	cat /sys/lib/kbmap/$kbmap >/dev/kbmap
# the root: the kernel's gefs (its 9P posted by the kernel, devgefs)
if(test -e '#s/gefs.root')
	echo init: / on gefs

# /n and /mnt: a directory for each name used (/mnt/web: webfs)
mntgen -s slashn /n
mntgen -s slashmnt /mnt
mkdir -p /tmp /usr/$user

# the network: the interfaces, then ip=dhcp (DHCP on the first
# ethernet) or ip=ADDRESSES (ip/ipconfig's arguments); none without ip=
bind -qa '#l' /net
bind -qa '#I' /net
bind -qa '#a' /net
if(! ~ $#ip 0 && ! ~ $ip none && test -e /net/ether0){
	if(~ $ip dhcp)
		ip=()
	ip/ipconfig $ip
	ndb/cs
	ndb/dns -r
	webfs
	echo init: net `{grep -h 'ip=' /net/ndb | sed 1q}
}

if(! ~ $#ktest 0)
	ktest `{echo $ktest}

home=/usr/$user
cd $home
prompt=($sysname^'% ' '	')
fn $sysname% { $* }
if(test -r $home/lib/profile)
	exec rc -l -i </dev/cons >/dev/cons >[2=1]
exec rc -i </dev/cons >/dev/cons >[2=1]

#!/bin/rc

# prereq: mountdist
# desc: copy the distribution into the file system

switch($1){
case checkready
	if(! test -d /n/dist/dist/9front){
		copydist=notdone
		export copydist
		exit
	}
	if(test -d /n/newfs/dist/9front && test -f /tmp/copydone){
		copydist=done
		export copydist
		exit
	}
case go
	rm -f /tmp/copydone
	# Plan2001: this takes long on a slow disk; show that it is working
	echo 'Copying the distribution (a dot every 2 seconds)'
	busy disk/mkfs -z 16372 -U -s /n/dist -d /n/newfs /sys/lib/sysconfig/proto/allproto
	touch /tmp/copydone

case checkdone
	if(! test -f /tmp/copydone){
		copydist=notdone
		export copydist
	}
}

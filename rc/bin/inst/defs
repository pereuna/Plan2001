# Plan2001: the install medium (plan2001=install in its plan9.ini).  Its
# running file system partition (bootrc's bootargs) and its disk; both
# empty elsewhere.
fn mediumroot {
	if(~ $plan2001 install && ~ $"bootargs local!/dev/sd*)
		echo $"bootargs | sed 's/^local!//'
}
fn mediumdisk {
	r=`{mediumroot}
	if(! ~ $#r 0)
		basename -d $r | sed 's!^/dev/!!'
}

# Plan2001: run a long command (one that ends by itself, not a file server
# that stays) with a dot every 2 seconds, so a slow disk does not look
# like a hung installer; its status is the command's
fn busy {
	$* &
	busypid=$apid
	while(test -e /proc/$busypid){
		echo -n .
		sleep 2
	}
	echo
	wait $busypid
}

fn prompt {
	def=()
	hide=()
	what=()
	if(~ $1 -d && ! ~ $#* 1){
		def=$2
		shift
		shift
	}
	if(~ $1 -h && ! ~ $#* 1){
		hide=$2
		shift
		shift
	}

	optstr=()
	if(~ $1 -w && ! ~ $#* 1){
		optstr=$2
		shift
		shift
	}

	pr=$1
	shift

	opts=($*)
	if(~ $#opts 0) {
		suf=' '
	}
	if not if(! ~ $#optstr 0) {
		if(~ $optstr '') 
			suf=' '
		if not {
			pr=$pr^' ('^$"optstr^')'
			suf=''
		}
	}
	if not {
		pr=$pr^' ('^$1
		shift
		for(i)
			pr=$pr^', '^$i
		pr=$pr^')'
		suf=''
	}

	if(~ $#def 1)
		pr=$pr^$suf^'['^$def^']'
	if not
		pr=$pr^$suf^'[no default]'

	pr=$pr^': '


	okay=no
	while(~ $okay no) {
		echo -n current >$wctl
		echo -n top >$wctl
		echo -n $pr >[1=2]
		ifs='' {rd=`{read}}
		if(~ $#rd 0)
			exit notdone
		if(~ $rd !*){
			ifs='' {rd=`{echo $rd | sed 's/!//'}}
			echo $rd
			rc -c $rd
			echo !$status
		}
		if not{
			rd=`{echo $rd}
			if(~ $#rd 0 || ~ $rd '')
				rd=$def
	
			switch($#opts){
			case 0
				if(! ~ $rd '')
					okay=yes
			case *
				if(~ $rd $opts $hide)
					okay=yes
			}
		}
	}
	echo -n $rd >/env/rd	# just in case
}


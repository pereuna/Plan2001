#!/bin/rc

cd /bin/inst
. ./defs
fn sigint { }

coherence

# we run this while() here so that ctl-d won''t exit from us -- it''ll only exit main!
# main contains a while() loop too, to avoid the hit of 
# continually reexecing from here.

# Plan2001: main returns only when its menu is left (Delete, ^D or
# quit); then so do we, to the shell.  inst/start comes back.
./main
echo
echo 'Left the installer; inst/start to go on.'

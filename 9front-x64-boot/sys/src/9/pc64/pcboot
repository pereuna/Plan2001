# pcboot - minimal amd64 kernel: boots only as far as exec("/boot/boot")
#
# Contains just what the UEFI boot path needs: the devices initcode binds
# (#/ #c #d #e #p #s and the shr device), no network, no disks, no graphics.
# Console output goes to the 8250 serial port (set console=0 in plan9.ini).
# Build:	mk 'CONF=pcboot' 'IPFILES=noip'
dev
	root
	cons
	swap
	arch
	pnp		pci
	env
	proc
	srv
	shr
	dup
	mnt
	rtc
	uart

misc
	pci		pcipc
	archgeneric	i8259 i8253
	archacpi	mp apic squidboy ec hpet
	mtrr
	uarti8250

port
	int cpuserver = 0;

	/*
	 * Empty stand-ins for code that is not part of this stripped kernel:
	 * VMX hypervisor, PS/2 keyboard-controller reset, and the VESA and
	 * Multiboot framebuffer helpers used only by multibootargs().
	 */
	void vmxshutdown(void) {}
	void vmxprocrestore(Proc*) {}
	void i8042reset(void) {}
	char* rgbmask2chan(char*, int, u32int, u32int, u32int) { return nil; }
	char* vesabootscreenconf(char*, char*, uchar*) { return nil; }

bootdir
	boot

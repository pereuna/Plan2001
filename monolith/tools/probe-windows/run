#!/usr/bin/env python3
"""One machine, many browser windows: what the browser allows (docs/web-windows.md).
In headless Chromium (chromium on PATH), with the COOP and COEP headers the
machine's page has (rc-httpd's plan2001-static, tools/serve):
  sharedworker  the machine in a SharedWorker (sw.js): two tabs, one instance;
                cross-origin isolated, SharedArrayBuffer, a Worker of its
                own (a proc's: nested.js, then leaf.js), OPFS's sync handle,
                shared memory posted to a page
  popup         the machine in a tab (machine.html): a window it opens
                (win.html) gets its shared memory and sees a proc's Worker
                write it
  broker        a tab the user opens (term.html) gets a MessagePort to the
                machine's tab through a SharedWorker (broker.js)
Prints what each gives; exit 0 whatever it is (a probe, not a test).
  monolith/tools/probe-windows/run
"""
import json, os, subprocess, sys, tempfile, threading, time, urllib.parse, urllib.request
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler

here = os.path.dirname(os.path.abspath(__file__))
# test-wasmapp's DevTools client (the part before its main)
tw = os.path.join(os.path.dirname(here), 'test-wasmapp')
src = open(tw).read()
ns = {'__file__': tw}
exec(compile(src[:src.index('\ndef main():')], tw, 'exec'), ns)
Cdp = ns['Cdp']
HTTP, DT = 18311, 18312

class H(SimpleHTTPRequestHandler):
	def __init__(s, *a, **k):
		super().__init__(*a, directory=here, **k)
	def end_headers(s):
		s.send_header('Cross-Origin-Opener-Policy', 'same-origin')
		s.send_header('Cross-Origin-Embedder-Policy', 'require-corp')
		s.send_header('Cache-Control', 'no-store')
		super().end_headers()
	def log_message(s, *a):
		pass
H.extensions_map['.js'] = 'text/javascript'

def tab(path):
	url = f'http://127.0.0.1:{HTTP}/{path}'
	t = json.loads(urllib.request.urlopen(urllib.request.Request(
		f'http://127.0.0.1:{DT}/json/new?{urllib.parse.quote(url, safe="")}', method='PUT')).read())
	c = Cdp(t['webSocketDebuggerUrl'])
	c.call('Runtime.enable')
	c.tid = t['id']
	return c

def until(c, expr, secs=15):
	end = time.time() + secs
	while time.time() < end:
		try:
			v = c.js(expr)
			if v:
				return v
		except RuntimeError:
			pass
		time.sleep(0.3)
	return None

srv = ThreadingHTTPServer(('127.0.0.1', HTTP), H)
threading.Thread(target=srv.serve_forever, daemon=True).start()
ch = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-gpu', f'--user-data-dir={tempfile.mkdtemp()}',
	f'--remote-debugging-port={DT}', 'about:blank'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
try:
	for _ in range(50):
		try:
			urllib.request.urlopen(f'http://127.0.0.1:{DT}/json')
			break
		except Exception:
			time.sleep(0.2)
	print('browser:', json.loads(urllib.request.urlopen(f'http://127.0.0.1:{DT}/json/version').read())['Browser'])
	a = tab('page.html?a')
	ra = until(a, 'window.r && window.r.msgs.length && window.r.msgs[0]')
	b = tab('page.html?b')
	rb = until(b, 'window.r && window.r.msgs.length && window.r.msgs[0]')
	a.js('ask({sendmem: 1})')
	sent = until(a, 'window.r.msgs.find((m) => m.sentmem) && window.r.msgs.find((m) => m.sentmem).sentmem')
	print('sharedworker: one instance for two tabs:', ra['id'] == rb['id'], f'(connections {rb["conns"]})')
	print('sharedworker: crossOriginIsolated', ra['iso'], '- SharedArrayBuffer', ra['sab'], '- Atomics.wait', ra['atomicswait'])
	print('sharedworker: Worker', ra['worker'], '- a proc Worker:', json.dumps(ra['nested']))
	print('sharedworker: its shared memory to a page:', sent)
	m = tab('machine.html')
	until(m, 'window.r')
	m.call('Runtime.evaluate', expression='openwin()', userGesture=True)
	r = until(m, 'window.r.seen && window.r')
	print('popup: the machine tab\'s shared memory in its window, a proc writing it:', json.dumps(r and r['seen']))
	t = tab('term.html')
	r = until(t, 'window.r.got && window.r.got.length > 1 && window.r')
	print('broker: a tab the user opened, messages to the machine and back:', json.dumps(r and r['got']))
finally:
	ch.kill()
	srv.shutdown()

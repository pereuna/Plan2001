#!/usr/bin/env python3
"""Phase 3a acceptance: programs in browser tabs, driven like a user.

  tools/test-apps [--mobile] [--slow] [--login] [--drop] [URL-QUERY]

Starts headless Chromium with the DevTools protocol and opens two tabs on
Plan2001's webterm (https://127.0.0.1:17443, wss): /app/term, rc on
drawterm's console, where it types a command, and /app/clock, a graphical
program on the whole tab.  No rio: the browser's tabs are the windows.
On the VM's serial console apps must list both sessions attached, and
the clock detached once its tab is closed.  Screenshots build/app-*.png.
Input goes through the page's own event queue (window.monolith.push),
the same path as real events.  --mobile emulates a phone: text typed
through the on-screen keyboard's path (Input.insertText, as an IME does),
with a backspace.  --slow throttles the CPU 6x and adds 300 ms latency
(1 Mbit/s).  --login types the password into the page's login form, not
#pass=.  --drop drops the WebSockets just before typing; the session must
resume and the keys typed meanwhile arrive.
Needs the CPU VM running (Plan2001: tools/vm start --disk
~/.cache/plan2001/cpu.qcow2 --net, after tools/deploy) and its password
in ~/.cache/plan2001/cpu.pass.
"""
import base64, json, os, socket, struct, subprocess, sys, tempfile, time, urllib.parse, urllib.request

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
plan2001 = os.path.dirname(root)
cache = os.environ.get('PLAN2001_CACHE', os.path.expanduser('~/.cache/plan2001'))
password = open(os.path.join(cache, 'cpu.pass')).read().strip()
DEVTOOLS = 19222
Evmouse, Evkey = 1, 2
B1, B2, B3 = 1, 2, 4


class Cdp:
	"""The DevTools protocol over a minimal WebSocket client (text frames)."""
	def __init__(self, url):
		u = urllib.parse.urlparse(url)
		self.s = socket.create_connection((u.hostname, u.port))
		key = base64.b64encode(os.urandom(16)).decode()
		self.s.sendall((f'GET {u.path} HTTP/1.1\r\nHost: {u.netloc}\r\nUpgrade: websocket\r\n'
			f'Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n').encode())
		resp = b''
		while b'\r\n\r\n' not in resp:
			resp += self.s.recv(1)
		if b' 101 ' not in resp.split(b'\r\n')[0]:
			raise SystemExit(f'test-apps: DevTools handshake: {resp[:80]}')
		self.id = 0

	def read(self, n):
		b = b''
		while len(b) < n:
			x = self.s.recv(n - len(b))
			if not x:
				raise SystemExit('test-apps: DevTools connection closed')
			b += x
		return b

	def send(self, text):
		data = text.encode()
		n = len(data)
		hdr = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else
			bytes([0x80 | 126]) + struct.pack('>H', n) if n < 65536 else
			bytes([0x80 | 127]) + struct.pack('>Q', n))
		mask = os.urandom(4)
		self.s.sendall(hdr + mask + bytes(c ^ mask[i % 4] for i, c in enumerate(data)))

	def recv(self):
		msg = b''
		while True:
			b0, b1 = self.read(2)
			n = b1 & 0x7f
			if n == 126:
				n = struct.unpack('>H', self.read(2))[0]
			elif n == 127:
				n = struct.unpack('>Q', self.read(8))[0]
			data = self.read(n)
			if b0 & 0x0f in (1, 2, 0):
				msg += data
				if b0 & 0x80:
					return msg

	def call(self, method, **params):
		self.id += 1
		self.send(json.dumps({'id': self.id, 'method': method, 'params': params}))
		while True:
			r = json.loads(self.recv())
			if r.get('id') == self.id:
				if 'error' in r:
					raise RuntimeError(f'{method}: {r["error"]}')
				return r.get('result', {})

	def js(self, expr):
		r = self.call('Runtime.evaluate', expression=expr, returnByValue=True)
		return r.get('result', {}).get('value')


def wait(cdp, expr, secs, what):
	end = time.time() + secs
	while time.time() < end:
		if cdp.js(expr):
			return
		time.sleep(0.5)
	st = cdp.js("(document.getElementById('status') || {}).textContent")
	raise SystemExit(f'test-apps: timed out waiting for {what} (page: {st!r})')


def run9(cmd):
	"""A command on the VM's serial console (Plan2001's tools/9run)."""
	r = subprocess.run([os.path.join(plan2001, 'tools/9run'), '-d', os.path.join(plan2001, 'build/vm'), '-t', '30', cmd],
		capture_output=True, text=True)
	return r.stdout


def apps():
	out = run9('apps')
	return [l.split('\t') for l in out.splitlines() if l.count('\t') == 3 and not l.startswith('SESSION')]


old = set()	# sessions from before the test (a detached one stays a while)


def waitapps(want, secs, what):
	end = time.time() + secs
	while time.time() < end:
		got = sorted((a[3], a[2]) for a in apps() if a[0] not in old)
		if got == sorted(want):
			print(f'test-apps: apps: {got}')
			return
		time.sleep(2)
	raise SystemExit(f'test-apps: apps: {got}, not {sorted(want)} ({what})')


def target(url):
	"""A new tab: its DevTools connection and id."""
	t = json.load(urllib.request.urlopen(urllib.request.Request(
		f'http://127.0.0.1:{DEVTOOLS}/json/new?{urllib.parse.quote(url, safe="")}', method='PUT')))
	return Cdp(t['webSocketDebuggerUrl']), t['id']


def main():
	argv = sys.argv[1:]
	mobile = '--mobile' in argv
	slow = '--slow' in argv
	login = '--login' in argv
	drop = '--drop' in argv
	argv = [a for a in argv if a not in ('--mobile', '--slow', '--login', '--drop')]
	query = argv[0] if argv else ''
	tmp = tempfile.mkdtemp()
	spki = subprocess.run([os.path.join(root, 'tools/spki')], capture_output=True, text=True).stdout.strip()
	chrome = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-gpu',
		f'--ignore-certificate-errors-spki-list={spki}',
		f'--user-data-dir={tmp}', f'--remote-debugging-port={DEVTOOLS}',
		'--window-size=1024,768', 'about:blank'],
		stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	try:
		for _ in range(50):
			try:
				pages = json.load(urllib.request.urlopen(f'http://127.0.0.1:{DEVTOOLS}/json'))
				page = next(p for p in pages if p['type'] == 'page')
				break
			except Exception:
				time.sleep(0.2)
		old.update(a[0] for a in apps())
		cdp = Cdp(page['webSocketDebuggerUrl'])
		cdp.call('Page.enable')
		if mobile:	# a Pixel 7
			cdp.call('Emulation.setDeviceMetricsOverride', width=412, height=915,
				deviceScaleFactor=2.625, mobile=True)
			cdp.call('Emulation.setTouchEmulationEnabled', enabled=True, maxTouchPoints=5)
		if slow:	# a phone behind a slow tunnel: 6x slower CPU, 300 ms each way
			cdp.call('Network.enable')
			cdp.call('Network.emulateNetworkConditions', offline=False, latency=300,
				downloadThroughput=100_000 // 8 * 10, uploadThroughput=100_000 // 8 * 10)
			cdp.call('Emulation.setCPUThrottlingRate', rate=6)
		url = f'https://127.0.0.1:17443/app/term?{query}#pass={password}'
		if login:
			url = url.split('#')[0]
		cdp.call('Page.navigate', url=url)
		if login:
			wait(cdp, "document.activeElement && document.activeElement.id === 'pass'", 30, 'the login form')
			cdp.call('Input.insertText', text=password)
			cdp.call('Input.dispatchKeyEvent', type='keyDown', key='Enter', code='Enter', windowsVirtualKeyCode=13, text='\r')
			cdp.call('Input.dispatchKeyEvent', type='keyUp', key='Enter', code='Enter', windowsVirtualKeyCode=13)
			if '#' in cdp.js('location.href'):
				raise SystemExit('test-apps: the address still has a fragment')
		prefix = 'mobile-' if mobile else ''

		# at typing speed: drawterm drops keys when its queue is full
		def type(s):
			if mobile:
				for c in s:
					cdp.call('Input.insertText', text=c)
					time.sleep(0.04)
			else:
				cdp.call('Runtime.evaluate', awaitPromise=True, expression=
					f'(async () => {{ for (const c of {json.dumps(s)}) {{ const r = c.codePointAt(0); '
					f'window.monolith.push({Evkey}, r, 1, 0); window.monolith.push({Evkey}, r, 0, 0); '
					f'await new Promise(t => setTimeout(t, 40)); }} }})()')
			time.sleep(0.5)

		def backspace():
			for kind in ('keyDown', 'keyUp'):
				cdp.call('Input.dispatchKeyEvent', type=kind, key='Backspace', code='Backspace',
					windowsVirtualKeyCode=8, nativeVirtualKeyCode=8)
			time.sleep(0.3)

		def shot(c, name):
			png = c.call('Page.captureScreenshot', format='png')['data']
			path = os.path.join(root, 'build', f'app-{prefix}{name}.png')
			open(path, 'wb').write(base64.b64decode(png))
			print(f'test-apps: {name}: build/app-{prefix}{name}.png')

		def settle(t0):
			for _ in range(60):
				f = cdp.js('window.monolith.flushes')
				time.sleep(1)
				if cdp.js('window.monolith.flushes') == f:
					break
			print(f'test-apps: typed line settled in {time.time() - t0 - 1:.1f}s')

		wait(cdp, 'window.monolith && window.monolith.flushes > 0', 180, "the term tab's console")
		time.sleep(8)	# until rc's prompt (the profile runs first)
		if cdp.js('document.title') != 'term · Plan2001':
			raise SystemExit(f"test-apps: title {cdp.js('document.title')!r}")
		if mobile:
			cdp.call('Input.dispatchTouchEvent', type='touchStart', touchPoints=[{'x': 200, 'y': 200}])
			cdp.call('Input.dispatchTouchEvent', type='touchEnd', touchPoints=[])
			cdp.js("document.getElementById('kbd').focus()")
		if drop:
			cdp.js('window.monolith.dropnet()')
			print('test-apps: WebSockets dropped')
		t0 = time.time()
		if mobile:
			type('echo MONOLITH-OX')
			backspace()
			type('K; cat /dev/sysname; echo\n')
		else:
			type('echo MONOLITH-OK; cat /dev/sysname; echo\n')
		if drop:
			wait(cdp, 'window.monolith.resumes > 0', 30, 'the session to resume')
			print('test-apps: resumed')
		settle(t0)
		shot(cdp, 'term')
		waitapps([('term', 'attached')], 30, 'the term tab')

		# a second tab: a graphical program, no window system
		clock, cid = target(f'https://127.0.0.1:17443/app/clock#pass={password}')
		clock.call('Page.enable')
		wait(clock, 'window.monolith && window.monolith.flushes > 1', 180, 'the clock tab to draw')
		time.sleep(3)
		shot(clock, 'clock')
		waitapps([('term', 'attached'), ('clock', 'attached')], 30, 'both tabs')
		urllib.request.urlopen(f'http://127.0.0.1:{DEVTOOLS}/json/close/{cid}')
		waitapps([('term', 'attached'), ('clock', 'detached')], 30, 'the clock tab closed')
		print(f"test-apps: {cdp.js('window.monolith.flushes')} flushes in the term tab")
		print('PASS: term and clock in their own tabs, sessions listed by apps')
	finally:
		chrome.terminate()
		chrome.wait()


main()

#!/bin/bash
# Development server for the wasm32 machine's page (D7: the terminal and
# the apps' origins are wasm32 machines; the CPU server's rc-httpd serves
# the same page, monolith/tools/pages):
#   http://ADDR:8080/  kernel.html (also as index.html), platform.js, the
#                      kernel and the root (tools/build-9wasm32, build-bin3),
#                      with the COOP/COEP headers its threads need; html, js
#                      and wasm gzipped
#   ADDR:8081          a TCP relay to the Plan2001 VM's webterm (WebSockets
#                      to rcpu and auth; tools/vm --net forwards it to
#                      127.0.0.1:17080), so the page reaches the VM from here
# ADDR is 127.0.0.1 unless --listen says otherwise (e.g. a WireGuard
# address; browsers give SharedArrayBuffer only to localhost and HTTPS, so
# there the browser must be told to trust the origin, e.g. in Chrome's
# chrome://flags "Insecure origins treated as secure").
#   tools/serve [--listen ADDR] [HTTPPORT [WSPORT]]
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
addr=127.0.0.1
[ "$1" = --listen ] && { addr=$2; shift 2; }
http=${1:-8080} ws=${2:-8081}
webterm=${MONOLITH_WEBTERM:-17080}
site=$root/build/site
rm -rf "$site"; mkdir -p "$site"
# the machine's root (tools/build-bin3): one file, or its files and list
mkdir -p "$root/build/wasm32/root"; touch "$root/build/wasm32/root.txt"
ln -sfn "$root/build/wasm32/root" "$site/w3root"
ln -sfn "$root/build/wasm32/root.txt" "$site/w3root.txt"
touch "$root/build/wasm32/root.fs"; ln -sfn "$root/build/wasm32/root.fs" "$site/w3root.fs"
# Plan2001's wasm32 kernel (tools/build-9wasm32): kernel.html boots it - the
# page and platform.js are wasm32's firmware, in the fork (plan9/sys/src/9/wasm32)
mkdir -p "$root/build/wasm32/kernel"
ln -sfn "$root/build/wasm32/kernel/9wasm32.wasm" "$site/9wasm32.wasm"
ln -sfn "$root/../plan9/sys/src/9/wasm32/platform.js" "$site/platform.js"
ln -sfn "$root/../plan9/sys/src/9/wasm32/kernel.html" "$site/kernel.html"
ln -sfn "$root/../plan9/sys/src/9/wasm32/kernel.html" "$site/index.html"
# the site's secstore (kernel.html: GET /secstore), as the CPU server's
# (tools/vm-cpu) names its own: MONOLITH_SECSTORE=dialstring, else none
[ -z "${MONOLITH_SECSTORE:-}" ] || echo "$MONOLITH_SECSTORE" >"$site/secstore"
# and its login (kernel.html: GET /login; docs/webauthn.md): MONOLITH_LOGIN=1
[ -z "${MONOLITH_LOGIN:-}" ] || echo 1 >"$site/login"

cd "$site"
pids=
trap 'kill $pids 2>/dev/null' EXIT
trap 'exit 1' INT TERM
python3 - "$addr" "$ws" "$webterm" <<'PY' &
import asyncio, sys
async def pipe(r, w):
	try:
		while (b := await r.read(65536)):
			w.write(b)
			await w.drain()
	finally:
		w.close()
async def relay(cr, cw):
	try:
		vr, vw = await asyncio.open_connection('127.0.0.1', int(sys.argv[3]))
	except OSError:
		cw.close()
		return
	await asyncio.gather(pipe(cr, vw), pipe(vr, cw), return_exceptions=True)
async def main():
	srv = await asyncio.start_server(relay, sys.argv[1], int(sys.argv[2]))
	await srv.serve_forever()
asyncio.run(main())
PY
pids="$pids $!"
python3 - "$addr" "$http" <<'PY' &
import email.utils, gzip, http.server, os, sys
zipped = {}	# path -> (mtime, gzip bytes)
class H(http.server.SimpleHTTPRequestHandler):
	# keep-alive: on a lossy link every new connection risks a lost SYN
	protocol_version = 'HTTP/1.1'
	# html, js and wasm go gzipped (a third of the size; slow links)
	def do_GET(self):
		path = self.translate_path(self.path)
		if not path.endswith(('.html', '.js', '.wasm')) or 'gzip' not in self.headers.get('Accept-Encoding', '') \
		or not os.path.isfile(path):
			return super().do_GET()
		mtime = int(os.stat(path).st_mtime)
		ims = self.headers.get('If-Modified-Since')
		if ims:
			try:
				if int(email.utils.parsedate_to_datetime(ims).timestamp()) >= mtime:
					self.send_response(304)
					self.send_header('Content-Length', '0')
					self.end_headers()
					return
			except (TypeError, ValueError):
				pass
		if zipped.get(path, (None,))[0] != mtime:
			zipped[path] = (mtime, gzip.compress(open(path, 'rb').read(), 9))
		body = zipped[path][1]
		self.send_response(200)
		self.send_header('Content-Type', self.guess_type(path))
		self.send_header('Content-Encoding', 'gzip')
		self.send_header('Vary', 'Accept-Encoding')
		self.send_header('Content-Length', str(len(body)))
		self.send_header('Last-Modified', email.utils.formatdate(mtime, usegmt=True))
		self.end_headers()
		self.wfile.write(body)
	def end_headers(self):
		self.send_header('Cross-Origin-Opener-Policy', 'same-origin')
		self.send_header('Cross-Origin-Embedder-Policy', 'require-corp')
		self.send_header('Cache-Control', 'no-cache')	# revalidate: 304 unless changed
		super().end_headers()
	def log_message(self, *a):
		pass
H.extensions_map['.wasm'] = 'application/wasm'
http.server.ThreadingHTTPServer((sys.argv[1], int(sys.argv[2])), H).serve_forever()
PY
pids="$pids $!"
echo "serve: http://$addr:$http/  webterm ws://$addr:$ws (-> 127.0.0.1:$webterm)"
wait -n

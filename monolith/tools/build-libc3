#!/bin/bash
# 9front's libc for wasm32 (3c): port, 9sys and fmt from
# ../subset/9front/sys/src/libc, Plan2001's ../plan9/sys/src/libc/wasm32 for
# what 386 has in assembler, compiled by 3c (tools/build-cc native 3c)
# with ../plan9/wasm32/include and 9front's /sys/include.
#   tools/build-libc3     build/wasm32/lib/libc.a, libdraw.a (9front's
#                         libdraw: the parts with libthread compile, for
#                         later), libthread.a, libauth.a, lib9p.a, libmemdraw.a, libmemlayer.a,
#                         libframe.a, libcomplete.a, libplumb.a, libregexp.a, libflate.a,
#                         libip.a, libndb.a, libmp.a, libsec.a, libauthsrv.a
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
P=$(cd "$root/.." && pwd)
lib=$P/subset/9front/sys/src/libc
out=$root/build/wasm32
cc3=$root/build/cc-native/3c
"$root/tools/build-cc" native 3c >/dev/null
mkdir -p "$out/lib" "$out/o/libc"
rm -f "$out/o/libc/"*.3
INC="-I$P/plan9/wasm32/include -I$P/subset/9front/sys/include"
srcs=()
for d in port 9sys fmt; do
	for f in "$lib/$d"/*.c; do
		case $d/$(basename "$f") in
		9sys/callmain.c) ;;	# wasm32/main9.c
		*) srcs+=("$f") ;;
		esac
	done
done
# ucd: the Unicode tables (toupperrune, isalpharune ...), as its mkfile lists them
for f in runenorm runetotype runeistype runebreak; do srcs+=("$lib/ucd/$f.c"); done
srcs+=("$P"/plan9/sys/src/libc/wasm32/*.c)
# the system calls: one file each, as Plan 9's 9syscall makes them (a
# program, or the kernel, gets only those it calls): _trap(n, &first)
sc=$out/o/9syscall
rm -rf "$sc"; mkdir -p "$sc"
sed '/^#define._X[123]/d; s/#define[ 	]*\([A-Z0-9_]*\)[ 	]*\([0-9]*\).*/\1 \2/' "$lib/9syscall/sys.h" | grep -v '^$' |
while read N n; do
	i=$(echo $N | tr A-Z a-z)
	case $i in exits|nsec) i=_$i ;; esac
	printf 'typedef long long vlong;\nextern vlong _trap(int, void*);\n\nvlong\n%s(void *a)\n{\n\treturn _trap(%s, &a);\n}\n' "$i" "$n" >"$sc/$i.c"
done
srcs+=("$sc"/*.c)
fail=0
for s in "${srcs[@]}"; do
	d=$(basename "$(dirname "$s")")
	o=$out/o/libc/$d-$(basename "${s%.c}").3
	if ! (cd "$(dirname "$s")" && "$cc3" -FVw $INC -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
		echo "build-libc3: $s:"; head -5 "$o.err"; fail=1
	fi
done
[ $fail = 0 ] || exit 1
rm -f "$out/lib/libc.a"
ar rcD "$out/lib/libc.a" "$out"/o/libc/*.3
echo "build-libc3: $out/lib/libc.a ($(ls "$out"/o/libc/*.3 | wc -l) objects)"

# libdraw
mkdir -p "$out/o/libdraw"
rm -f "$out/o/libdraw/"*.3
for s in "$P"/subset/9front/sys/src/libdraw/*.c; do
	case $(basename "$s") in test.c|warptest.c) continue ;; esac
	o=$out/o/libdraw/$(basename "${s%.c}").3
	if ! (cd "$(dirname "$s")" && "$cc3" -FVw $INC -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
		echo "build-libc3: $s:"; head -5 "$o.err"; fail=1
	fi
done
[ $fail = 0 ] || exit 1
# libthread: 9front's, with wasm32's own scheduler and main (contexts, not longjmp)
mkdir -p "$out/o/libthread"
rm -f "$out/o/libthread/"*.3
for s in "$P"/subset/9front/sys/src/libthread/*.c "$P"/plan9/sys/src/libthread/wasm32/*.c; do
	case $s in
	*/subset/*/386.c|*/subset/*/amd64.c|*/subset/*/arm64.c|*/subset/*/arm.c|*/subset/*/mips.c|*/subset/*/power.c|*/subset/*/power64.c|\
	*/subset/*/example.c|*/subset/*/test.c|*/subset/*/tprimes.c|*/subset/*/sched.c|*/subset/*/main.c) continue ;;
	esac
	o=$out/o/libthread/$(basename "$(dirname "$s")")-$(basename "${s%.c}").3
	if ! (cd "$(dirname "$s")" && "$cc3" -FVw $INC -I"$P/subset/9front/sys/src/libthread" -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
		echo "build-libc3: $s:"; head -5 "$o.err"; fail=1
	fi
done
[ $fail = 0 ] || exit 1
rm -f "$out/lib/libthread.a"
ar rcD "$out/lib/libthread.a" "$out"/o/libthread/*.3
echo "build-libc3: $out/lib/libthread.a ($(ls "$out"/o/libthread/*.3 | wc -l) objects)"

# libmemdraw, libmemlayer: 9front's (the kernel's devdraw)
for l in libmemdraw libmemlayer; do
	mkdir -p "$out/o/$l"
	rm -f "$out/o/$l/"*.3
	for s in "$P"/subset/9front/sys/src/$l/*.c; do
		case $(basename "$s") in mkcmap.c) continue ;; esac	# a program
		o=$out/o/$l/$(basename "${s%.c}").3
		if ! (cd "$(dirname "$s")" && "$cc3" -FVw $INC -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
			echo "build-libc3: $s:"; head -5 "$o.err"; fail=1
		fi
	done
	[ $fail = 0 ] || exit 1
	rm -f "$out/lib/$l.a"
	ar rcD "$out/lib/$l.a" "$out"/o/$l/*.3
	echo "build-libc3: $out/lib/$l.a ($(ls "$out"/o/$l/*.3 | wc -l) objects)"
done

# libframe, libcomplete, libplumb, libregexp: rio's, window's sed's; libflate: gunzip's (the installer's)
for l in "$P"/subset/9front/sys/src/libframe "$P"/subset/9front/sys/src/libcomplete "$P"/subset/9front/sys/src/libplumb "$P"/subset/9front/sys/src/libregexp "$P"/subset/9front/sys/src/libflate; do
	n=$(basename "$l")
	mkdir -p "$out/o/$n"
	rm -f "$out/o/$n/"*.3
	for s in "$l"/*.c; do
		o=$out/o/$n/$(basename "${s%.c}").3
		if ! (cd "$l" && "$cc3" -FVw $INC -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
			echo "build-libc3: $s:"; head -5 "$o.err"; fail=1
		fi
	done
	[ $fail = 0 ] || exit 1
	rm -f "$out/lib/$n.a"
	ar rcD "$out/lib/$n.a" "$out"/o/$n/*.3
	echo "build-libc3: $out/lib/$n.a ($(ls "$out"/o/$n/*.3 | wc -l) objects)"
done

# libauth: 9front's (amount: lib9p's postmountsrv)
mkdir -p "$out/o/libauth"
rm -f "$out/o/libauth/"*.3
for s in "$P"/subset/9front/sys/src/libauth/*.c; do
	o=$out/o/libauth/$(basename "${s%.c}").3
	if ! (cd "$(dirname "$s")" && "$cc3" -FVw $INC -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
		echo "build-libc3: $s:"; head -5 "$o.err"; fail=1
	fi
done
[ $fail = 0 ] || exit 1
rm -f "$out/lib/libauth.a"
ar rcD "$out/lib/libauth.a" "$out"/o/libauth/*.3
echo "build-libc3: $out/lib/libauth.a ($(ls "$out"/o/libauth/*.3 | wc -l) objects)"

# lib9p: 9front's (kbdfs, file servers)
mkdir -p "$out/o/lib9p"
rm -f "$out/o/lib9p/"*.3
for s in "$P"/subset/9front/sys/src/lib9p/*.c; do
	case $(basename "$s") in ramfs.c|ftest.c) continue ;; esac
	o=$out/o/lib9p/$(basename "${s%.c}").3
	if ! (cd "$(dirname "$s")" && "$cc3" -FVw $INC -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
		echo "build-libc3: $s:"; head -5 "$o.err"; fail=1
	fi
done
[ $fail = 0 ] || exit 1
rm -f "$out/lib/lib9p.a"
ar rcD "$out/lib/lib9p.a" "$out"/o/lib9p/*.3
echo "build-libc3: $out/lib/lib9p.a ($(ls "$out"/o/lib9p/*.3 | wc -l) objects)"

# libip, libndb, libmp, libsec, libauthsrv, libString: 9front's (factotum, authdial; D3),
# their files as their mkfiles list them (OFILES or CFILES), the C of port/
mkvar() {	# MKFILE VAR: the names in VAR=..., .$O and .c taken off
	awk -v v="$2" '$0 ~ "^"v"[ \t]*=" { on=1; sub("^[^=]*=", "") } on { c = /\\$/; gsub(/\\/, ""); for(i=1;i<=NF;i++) print $i; if(!c) on=0 }' "$1" |
		sed 's/\.\$O$//; s/\.c$//'
}
for l in libip libndb libmp/port libsec/port libauthsrv libString; do
	d=$P/subset/9front/sys/src/$l
	n=$(echo $l | sed 's|/port$||')
	case $n in libsec) v=CFILES ;; libmp) v=FILES ;; *) v=OFILES ;; esac
	mkdir -p "$out/o/$n"
	rm -f "$out/o/$n/"*.3
	for f in $(mkvar "$d/mkfile" $v); do
		o=$out/o/$n/$f.3
		if ! (cd "$d" && "$cc3" -FVw $INC -I"$P/subset/9front/sys/src/libmp/port" -o "$o" "$f.c") >"$o.err" 2>&1; then
			echo "build-libc3: $d/$f.c:"; head -5 "$o.err"; fail=1
		fi
	done
	[ $fail = 0 ] || exit 1
	rm -f "$out/lib/$n.a"
	ar rcD "$out/lib/$n.a" "$out"/o/$n/*.3
	echo "build-libc3: $out/lib/$n.a ($(ls "$out"/o/$n/*.3 | wc -l) objects)"
done

rm -f "$out/lib/libdraw.a"
ar rcD "$out/lib/libdraw.a" "$out"/o/libdraw/*.3
echo "build-libc3: $out/lib/libdraw.a ($(ls "$out"/o/libdraw/*.3 | wc -l) objects)"

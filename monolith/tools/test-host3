#!/bin/bash
# wasm32 programs (3c, 3l) as processes on drawterm's kernel in the
# browser (wasm32host, docs/wasm32.md): each through tools/test-wasmapp,
# its console the platform's serial port #t/eia0 and its output the same
# as ../plan9/sys/src/cmd/3c/test/host3/NAME.out; what draws, by its pixels.
#   tools/test-host3        builds host3 and the root first
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
tools/build host3 >/dev/null
tools/build-bin3 >/dev/null
bad=0
x=$(cd "$root/../plan9/sys/src/cmd/3c/test/host3" && pwd)
t() {	# t NAME env...
	local n=$1; shift
	if env "$@" PROG=$n timeout 300 tools/test-wasmapp host3 3 >build/test-host3-$n.out 2>&1; then
		echo "test-host3: $n: ok"
	else
		echo "test-host3: $n: FAIL"; tail -3 build/test-host3-$n.out; bad=1
	fi
}
t hello SERIAL=1 EXPECT=$x/hello.out
t dclock DRAWS=1
t fork SERIAL=1 EXPECT=$x/fork.out
t rfmem SERIAL=1 EXPECT=$x/rfmem.out
t threads SERIAL=1 EXPECT=$x/threads.out
t preempt SERIAL=1 EXPECT=$x/preempt.out
t bytes SERIAL=1 EXPECT=$x/bytes.out SENDFILE=$x/bytes.in
t rc SERIAL=1 EXPECT=$x/rc.out ARGS='["-c", "echo a b c | wc; ls /bin/rc /bin/echo; for(i in 1 2) echo $i; x=`{echo one two}; echo $#x; cat /rc/lib/rcmain | wc -l"]'
t rc SERIAL=1 EXPECT=$x/rci.out ARGS='["-i"]' SEND='["echo hello over eia0\n", "echo a b c | wc\n", "ls /bin/rc /bin/echo\n", "x=(1 2 3); echo $#x\n", "exit\n"]'
t clock DRAWS=1 RUNS=1
[ $bad = 0 ] && echo PASS || { echo FAIL; exit 1; }

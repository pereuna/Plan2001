#!/bin/bash
# A Plan 9 program compiled by clang.wasm - the compiler as WebAssembly, as
# a browser would run it - and linked into drawterm's kernel (wasmapp/):
# docs/wasm-apps.md.  YoWASP's clang (@yowasp/clang, LLVM 22, 27 MB) is
# fetched once to ~/.cache/plan2001/yowasp-clang; it compiles APP.c for
# wasm32-unknown-emscripten with emcc's flags, emcc (wasm-ld) links that
# object instead of its own, tools/test-wasmapp checks it draws.  Then the
# build has emcc's object again.
#   tools/test-wasmclang [APP]     default clock; needs tools/build wasm-APP
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
app=${1:-clock}
ver=22.0.0-git20542-10
yw=${PLAN2001_CACHE:-$HOME/.cache/plan2001}/yowasp-clang/$ver
b=$root/build/wasm-$app
say() { echo "test-wasmclang: $*"; }
[ -s "$b/9apps/$app.o" ] || { say "no $b: tools/build wasm-$app first"; exit 1; }
if [ ! -s "$yw/package/gen/bundle.js" ]; then
	say "fetching @yowasp/clang $ver (27 MB) to $yw"
	mkdir -p "$yw"
	curl -sSfL "https://registry.npmjs.org/@yowasp/clang/-/clang-$ver.tgz" | tar xzf - -C "$yw"
fi
cd "$b"
cp "9apps/$app.o" "9apps/$app.o.emcc"
trap 'cp "9apps/$app.o.emcc" "9apps/$app.o" && touch "9apps/$app.o" && rm -f "$app.js" &&
	make -f wasmapp/wasmapp.mk CONF=emscripten APP=$app $app.js >/dev/null 2>&1; rm -f "9apps/$app.o.emcc"' EXIT
emcc -include wasmapp/plan9.h -I. -I./include -I./kern -pthread -Dlinux -D_THREAD_SAFE -DPTHREAD -D_REENTRANT \
	'-D__builtin_return_address(x)=0' -Dmain=wasmappmain -M "9apps/$app.c" 2>/dev/null |
	tr -d '\\' | tr ' ' '\n' | grep -v '^$\|:$' >"$b/wasmclang.deps"
node "$root/tools/wasmclang-cc.mjs" "$yw/package" "$b/wasmclang.deps" "$b" "9apps/$app.c" "$b/9apps/$app.o" 2>&1 | grep -v 'yowasp-llvm: fetched'
touch "9apps/$app.o"
rm -f "$app.js"
make -f wasmapp/wasmapp.mk CONF=emscripten APP=$app $app.js >wasmclang.log 2>&1 || { tail -20 wasmclang.log; exit 1; }
say "linked $app.wasm ($(stat -c %s $app.wasm) bytes) with clang.wasm's $app.o"
"$root/tools/test-wasmapp" "$app" 4

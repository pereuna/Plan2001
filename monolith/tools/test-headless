#!/bin/bash
# drawterm.wasm in headless Chromium runs a command on the Plan2001 CPU VM
# and prints MONOLITH-OK to the page's console.
# Needs the VM running (Plan2001: tools/vm start --disk
# ~/.cache/plan2001/cpu.qcow2 --net) and its password in
# ~/.cache/plan2001/cpu.pass.
#   tools/test-headless [--vm] [SECONDS]
# --vm: the page from Plan2001's webterm (https://127.0.0.1:17443/, wss),
# not tools/serve; Chromium trusts that certificate's key only.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
vm=
[ "$1" = --vm ] && { vm=1; shift; }
secs=${1:-90}
pass=$(cat "${PLAN2001_CACHE:-$HOME/.cache/plan2001}/cpu.pass")
log=$root/build/headless.log
tmp=$(mktemp -d)
srv=
certflag=
if [ -n "$vm" ]; then
	certflag=--ignore-certificate-errors-spki-list=$("$root/tools/spki")
	url="https://127.0.0.1:17443/index.html?"
else
	"$root/tools/serve" 18080 18081 >/dev/null 2>&1 &
	srv=$!
	url="http://127.0.0.1:18080/index.html?ws=ws://127.0.0.1:18081"
fi
trap '[ -n "$srv" ] && kill $srv 2>/dev/null; rm -rf "$tmp"' EXIT
sleep 2
for a in -G -h 127.0.0.1 -a 'tcp!127.0.0.1!567' -u glenda -c 'echo MONOLITH-OK'; do
	url="$url&a=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$a")"
done
timeout "$secs" chromium --headless=new --no-sandbox --disable-gpu --user-data-dir="$tmp" $certflag \
	--enable-logging=stderr --window-size=1024,768 --v=0 "$url#pass=$pass" 2>&1 |
	sed "s/$pass/<password>/g" | tee "$log" | grep -m1 -q 'MONOLITH-EXIT' || true
if grep -q '"MONOLITH-OK"' "$log"; then
	echo "test-headless: MONOLITH-OK"
else
	echo "test-headless: no MONOLITH-OK, see $log" >&2
	grep 'CONSOLE' "$log" | tail -20 >&2
	exit 1
fi

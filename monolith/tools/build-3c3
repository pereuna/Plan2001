#!/bin/bash
# 3c compiled by 3c: the front end (third_party/9cc/cc, as Plan 9's cc.a:
# with compat), the back end (../plan9/sys/src/cmd/3c) and 9front's libbio, with
# 9front's libc for wasm32 (tools/build-libc3) -> build/wasm32/bin/3c.wasm,
# a WebAssembly 3c; and 3l the same way -> 3l.wasm.
#   tools/build-3c3
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
P=$(cd "$root/.." && pwd)
t=$root/third_party
out=$root/build/wasm32
cc3=$root/build/cc-native/3c
l3=$root/build/cc-native/3l
"$root/tools/build-cc" native 3c >/dev/null
"$root/tools/build-cc" native 3l >/dev/null
"$root/tools/build-libc3" >/dev/null
mkdir -p "$out/o/3c" "$out/o/3l" "$out/o/libbio" "$out/bin"
INC="-I$P/plan9/wasm32/include -I$P/subset/9front/sys/include"
fail=0
cc() {	# cc OUTDIR SRC EXTRA...
	local o=$1/$(basename "${2%.c}").3 s=$2; shift 2
	if ! (cd "$(dirname "$s")" && "$cc3" -FVw $INC "$@" -o "$o" "$(basename "$s")") >"$o.err" 2>&1; then
		echo "build-3c3: $s:"; head -5 "$o.err"; fail=1
	fi
}
rm -f "$out"/o/libbio/*.3 "$out"/o/3c/*.3 "$out"/o/3l/*.3
for f in "$P"/subset/9front/sys/src/libbio/*.c; do
	case $(basename "$f") in btestprint.c) continue ;; esac
	cc "$out/o/libbio" "$f"
done
for f in y.tab lex mac dcl acid pickle bits com scon funct sub com64 compat dpchk pgen pswt; do
	cc "$out/o/3c" "$t/9cc/cc/$f.c" -I"$P/plan9/sys/src/cmd/3c"
done
for f in cgen enam list sgen swt txt machcap; do
	cc "$out/o/3c" "$P/plan9/sys/src/cmd/3c/$f.c" -I"$t/9cc/cc"
done
for f in obj wasm; do
	cc "$out/o/3l" "$P/plan9/sys/src/cmd/3l/$f.c"
done
[ $fail = 0 ] || exit 1
rm -f "$out/lib/libbio.a"
ar rcD "$out/lib/libbio.a" "$out"/o/libbio/*.3
"$l3" -o "$out/bin/3c.wasm" "$out"/o/3c/*.3 "$out/lib/libbio.a" "$out/lib/libc.a"
"$l3" -o "$out/bin/3l.wasm" "$out"/o/3l/*.3 "$out/lib/libbio.a" "$out/lib/libc.a"
ls -l "$out/bin/3c.wasm" "$out/bin/3l.wasm"

#!/usr/bin/env python3
"""A command on a Plan2001 CPU server through its term app, from here.

  tools/term HOST 'rc command'      e.g. tools/term term.cpu.plan2001.com 'ls /lib/app'
  tools/term HOST --put FILE PATH    FILE from here to PATH there (typed as
                                     base64, decoded by auth/pemdecode)

For a server with no other way in (the cloud, docs/cloud.md): headless
Chromium opens https://HOST/ (the term app, drawterm in the page), logs in
as glenda with ~/.cache/plan2001/cpu.pass and types the command with its
output going to /sys/lib/monolith/o-NONCE.txt, which webterm serves; this
reads it over https, prints it and removes it.  Anything the command
prints is on the web for those seconds: print no secrets.  CA:
~/.cache/plan2001/ca/ca.pem.  Exit status: the command's ('' is 0).
"""
import base64, json, os, secrets, ssl, subprocess, sys, tempfile, time, urllib.parse, urllib.request

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(root, 'tools'))
cache = os.environ.get('PLAN2001_CACHE', os.path.expanduser('~/.cache/plan2001'))
password = open(os.path.join(cache, 'cpu.pass')).read().strip()
DEVTOOLS = 19226
Evkey = 2

import importlib.machinery, importlib.util
_l = importlib.machinery.SourceFileLoader('testapps', os.path.join(root, 'tools/test-apps'))
_s = importlib.util.spec_from_loader('testapps', _l)
ta = importlib.util.module_from_spec(_s)
sys.argv, _argv = [sys.argv[0]], sys.argv
try:
	src = open(os.path.join(root, 'tools/test-apps')).read().replace('\nmain()\n', '\n')
	exec(compile(src, 'test-apps', 'exec'), ta.__dict__)
finally:
	sys.argv = _argv
Cdp, wait = ta.Cdp, ta.wait


def typer(cdp, text, ms):
	cdp.call('Runtime.evaluate', awaitPromise=True, expression=
		f'(async () => {{ for (const c of {json.dumps(text)}) {{ const r = c.codePointAt(0); '
		f'window.monolith.push({Evkey}, r, 1, 0); window.monolith.push({Evkey}, r, 0, 0); '
		f'await new Promise(t => setTimeout(t, {ms})); }} }})()')


def main():
	put = None
	if len(sys.argv) == 5 and sys.argv[2] == '--put':
		host, src, dst = sys.argv[1], sys.argv[3], sys.argv[4]
		data = open(src, 'rb').read()
		b64 = base64.b64encode(data).decode()
		put = '-----BEGIN PLAN2001 FILE-----\n' + '\n'.join(b64[i:i+64] for i in range(0, len(b64), 64)) + '\n-----END PLAN2001 FILE-----\n'
		import hashlib
		cmd = f"auth/pemdecode 'PLAN2001 FILE' /tmp/put-{os.getpid()}.pem >{dst} && rm /tmp/put-{os.getpid()}.pem && md5sum {dst}"
		want = hashlib.md5(data).hexdigest()
	elif len(sys.argv) == 3:
		host, cmd = sys.argv[1], sys.argv[2]
	else:
		raise SystemExit('usage: tools/term HOST command | HOST --put FILE PATH')
	ctx = ssl.create_default_context(cafile=os.path.join(cache, 'ca/ca.pem'))
	nonce = secrets.token_hex(12)
	out = f'/sys/lib/monolith/o-{nonce}.txt'
	spki = subprocess.run([os.path.join(root, 'tools/spki')], capture_output=True, text=True).stdout.strip()
	tmp = tempfile.mkdtemp()
	chrome = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-gpu',
		f'--ignore-certificate-errors-spki-list={spki}', f'--user-data-dir={tmp}',
		f'--remote-debugging-port={DEVTOOLS}', 'about:blank'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	try:
		for _ in range(50):
			try:
				pages = json.load(urllib.request.urlopen(f'http://127.0.0.1:{DEVTOOLS}/json'))
				page = next(p for p in pages if p['type'] == 'page')
				break
			except Exception:
				time.sleep(0.2)
		cdp = Cdp(page['webSocketDebuggerUrl'])
		cdp.call('Page.enable')
		cdp.call('Page.navigate', url=f'https://{host}/#pass={password}')
		wait(cdp, 'window.monolith && window.monolith.flushes > 0', 120, "the term's console")
		time.sleep(6)
		if put is not None:
			# the file as PEM into a file there: cat from the console, ^D
			typer(cdp, f"cat >/tmp/put-{os.getpid()}.pem\n", 30)
			time.sleep(1)
			typer(cdp, put, int(os.environ.get('TERM_TYPEMS', '8')))
			time.sleep(1)
			typer(cdp, '\x04', 30)
			time.sleep(2)
		# a syntax error must reach the output too: rc -c in a subshell
		q = "'" + cmd.replace("'", "''") + "'"
		line = f"rc -c {q} >{out} >[2=1]; echo '#status' $status >>{out}\n"
		cdp.call('Runtime.evaluate', awaitPromise=True, expression=
			f'(async () => {{ for (const c of {json.dumps(line)}) {{ const r = c.codePointAt(0); '
			f'window.monolith.push({Evkey}, r, 1, 0); window.monolith.push({Evkey}, r, 0, 0); '
			f'await new Promise(t => setTimeout(t, 30)); }} }})()')
		text, end = '', time.time() + float(os.environ.get('TERM_TIMEOUT', '300'))
		while time.time() < end:
			try:
				text = urllib.request.urlopen(f'https://{host}/o-{nonce}.txt', context=ctx).read().decode('utf-8', 'replace')
				if '#status' in text.splitlines()[-1] if text.strip() else False:
					break
			except Exception:
				pass
			time.sleep(1)
		else:
			raise SystemExit(f'term: no result from {host} (so far: {text!r})')
		line = f"rm -f {out}\n"
		cdp.call('Runtime.evaluate', awaitPromise=True, expression=
			f'(async () => {{ for (const c of {json.dumps(line)}) {{ const r = c.codePointAt(0); '
			f'window.monolith.push({Evkey}, r, 1, 0); window.monolith.push({Evkey}, r, 0, 0); '
			f'await new Promise(t => setTimeout(t, 30)); }} }})()')
		time.sleep(2)
		lines = text.rstrip('\n').split('\n')
		st = lines[-1].split(None, 1)[1] if len(lines[-1].split()) > 1 else ''
		sys.stdout.write('\n'.join(lines[:-1]) + ('\n' if len(lines) > 1 else ''))
		if put is not None and want not in text:
			raise SystemExit(f'term: {dst} is not what was sent (md5 {want})')
		sys.exit(0 if st.strip() == '' else 1)
	finally:
		chrome.terminate()
		chrome.wait()


main()

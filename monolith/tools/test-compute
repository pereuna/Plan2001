#!/usr/bin/env python3
"""The compute pool, a first test (docs/cpu-server-design.md): a build
spread over browser tabs.

  tools/test-compute [TABS [WORKERS]]     (default 3 tabs, 2 workers each)
  KERNEL=1 tools/test-compute ...         the kernel (sys/src/9/pc64) instead of
                                          acme; its objects are listed where
                                          they differ (build dates)

Opens TABS headless Chromium tabs on Plan2001's cr.html
(https://compute.localhost:17443/cr.html, the compute origin), each a
compute resource (CR) with
WORKERS web workers running 6c.wasm, and waits until crsrv lists them in
/global/compute.  Then on the CPU VM's console, in the term app's
namespace (/lib/app/term/namespace: the pool on /compute), it builds acme twice in the
same directory: with Plan 9's own 6c, then with NPROC=12 mk CC=rcc, where
each compile is a job for the pool.  Every object and the linked 6.out
must be the same, and the jobs must have gone to more than one CR.
Needs the CPU VM running (tools/deploy).
"""
import json, os, subprocess, sys, tempfile, time, urllib.request

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
plan2001 = os.path.dirname(root)
DEVTOOLS = 19223


def run9(cmd, t=300):
	r = subprocess.run([os.path.join(plan2001, 'tools/9run'), '-d', os.path.join(plan2001, 'build/vm'), '-t', str(t), cmd],
		capture_output=True, text=True)
	return r.stdout


KBUILD = r'''
rfork e
test -e /global/compute/status || mount -c /srv/compute /global/compute
. /lib/app/term/namespace
rm -rf /tmp/ctest && mkdir -p /tmp/ctest/ref /tmp/ctest/k9 && dircp /sys/src/9 /tmp/ctest/k9
cd /tmp/ctest/k9/pc64 && mk clean >/dev/null >[2=1]
t0=`{date -n}
NPROC=2 mk 'CC=6c' >/tmp/ctest/local.out >[2=1] || echo LOCALFAIL
t1=`{date -n}
cp *.6 /tmp/ctest/ref/ && mk clean >/dev/null >[2=1]
t2=`{date -n}
NPROC=64 mk 'CC=rcc' >/tmp/ctest/mk.out >[2=1] || echo POOLFAIL
t3=`{date -n}
n=0; bad=0
for(f in /tmp/ctest/ref/*){ n=`{echo $n+1 | hoc}; cmp -s $f `{basename $f} || { bad=`{echo $bad+1 | hoc}; echo DIFF `{basename $f} } }
echo COMPARED $n DIFFERENT $bad
echo TIME local `{echo $t1-$t0 | hoc} pool `{echo $t3-$t2 | hoc}
ls -l 9pc64
for(d in /global/compute/[0-9]*) echo CR `{basename $d} `{cat $d/owner} jobs `{cat $d/jobs}
cat /global/compute/status
grep -v '^(rcc|6l|6a) ' /tmp/ctest/mk.out | sed 8q
'''


BUILD = r'''
rfork e
test -e /global/compute/status || mount -c /srv/compute /global/compute
. /lib/app/term/namespace
rm -rf /tmp/ctest && mkdir -p /tmp/ctest/ref /tmp/ctest/acme && dircp /sys/src/cmd/acme /tmp/ctest/acme
cd /tmp/ctest/acme && mk clean >/dev/null
t0=`{date -n}
NPROC=1 mk 'CC=6c' >/dev/null >[2=1] || echo LOCALFAIL
t1=`{date -n}
cp *.6 6.out ../ref/ && mk clean >/dev/null
t2=`{date -n}
NPROC=12 mk 'CC=rcc' >/tmp/ctest/mk.out >[2=1] || echo POOLFAIL
grep -v '^(rcc|6l) ' /tmp/ctest/mk.out
t3=`{date -n}
n=0; bad=0
for(f in /tmp/ctest/ref/*){ n=`{echo $n+1 | hoc}; cmp -s $f `{basename $f} || { bad=`{echo $bad+1 | hoc}; echo DIFF `{basename $f} } }
echo COMPARED $n DIFFERENT $bad
echo TIME local `{echo $t1-$t0 | hoc} pool `{echo $t3-$t2 | hoc}
for(d in /global/compute/[0-9]*) echo CR `{basename $d} `{cat $d/owner} jobs `{cat $d/jobs}
cat /global/compute/status
'''


def main():
	tabs = int(sys.argv[1]) if len(sys.argv) > 1 else 3
	workers = int(sys.argv[2]) if len(sys.argv) > 2 else 2
	spki = subprocess.run([os.path.join(root, 'tools/spki')], capture_output=True, text=True).stdout.strip()
	tmp = tempfile.mkdtemp()
	chrome = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-gpu',
		f'--ignore-certificate-errors-spki-list={spki}', f'--user-data-dir={tmp}',
		f'--remote-debugging-port={DEVTOOLS}', 'about:blank'],
		stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	try:
		for _ in range(50):
			try:
				urllib.request.urlopen(f'http://127.0.0.1:{DEVTOOLS}/json')
				break
			except Exception:
				time.sleep(0.2)
		for i in range(tabs):
			url = f'https://compute.localhost:17443/cr.html?workers={workers}&nolock'  # as if separate machines
			urllib.request.urlopen(urllib.request.Request(
				f'http://127.0.0.1:{DEVTOOLS}/json/new?{urllib.parse.quote(url, safe="")}', method='PUT'))
		end = time.time() + 60
		while time.time() < end:
			st = run9('test -e /global/compute/status || mount -c /srv/compute /global/compute; cat /global/compute/status', 30)
			if f'crs {tabs} ' in st:
				break
			time.sleep(2)
		else:
			raise SystemExit(f'test-compute: the tabs did not join the pool: {st.strip()!r}')
		print(f'test-compute: {tabs} CRs in the pool, {workers} workers each')
		# the script as a file (the serial console is no place for many lines),
		# through build/out.img, which the VM has as /dev/sdE2/data
		d = tempfile.mkdtemp()
		open(os.path.join(d, 'ctest.rc'), 'w').write(KBUILD if os.environ.get('KERNEL') else BUILD)
		tar = os.path.join(d, 'ctest.tar')
		subprocess.run(['tar', 'cf', tar, '--format=ustar', '-C', d, 'ctest.rc'], check=True)
		subprocess.run(['dd', f'if={tar}', f'of={os.path.join(plan2001, "build/out.img")}', 'bs=1M', 'conv=notrunc', 'status=none'], check=True)
		out = run9('@{cd /tmp && tar xf /dev/sdE2/data} && rc /tmp/ctest.rc', 1800)
		print(out.strip())
		ok = 'COMPARED' in out and 'LOCALFAIL' not in out and 'POOLFAIL' not in out and \
			(' DIFFERENT 0' in out or os.environ.get('KERNEL'))
		used = [l for l in out.splitlines() if l.startswith('CR ') and not l.endswith(' jobs 0')]
		if not ok:
			raise SystemExit('FAIL: the pool built something else')
		if len(used) < 2:
			raise SystemExit(f'FAIL: jobs went to {len(used)} CR(s)')
		print(f'PASS: acme built in the pool over {len(used)} browser CRs, objects the same as 6c\'s' + (' but for the build dates' if os.environ.get('KERNEL') else ''))
	finally:
		chrome.terminate()
		chrome.wait()


import urllib.parse
main()

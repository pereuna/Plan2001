# Linux: genhdr/ (the qstrs, the modules, the root pointers, the version)
# for this configuration, with gcc -E and MicroPython's Python scripts.
# Plan 9 has no CPython, so genhdr/ is in the tree: make genhdr after a
# change to mpconfigport.h or a new qstr.  The program is built on Plan 9
# by mkfile.
include $(CURDIR)/py/mkenv.mk
QSTR_DEFS = qstrdefsport.h
MICROPY_ROM_TEXT_COMPRESSION = 0
include $(TOP)/py/py.mk
INC = -I. -I$(TOP) -I$(BUILD)
CFLAGS += $(INC) -std=gnu99 -DNDEBUG
SRC_C = main.c p9hal.c modplan9.c shared/readline/readline.c shared/runtime/pyexec.c shared/runtime/stdout_helpers.c shared/runtime/gchelper_generic.c
SRC_QSTR += main.c modplan9.c shared/readline/readline.c shared/runtime/pyexec.c
OBJ += $(PY_CORE_O) $(addprefix $(BUILD)/,$(SRC_C:.c=.o))
GENHDR = qstrdefs.generated.h moduledefs.h root_pointers.h mpversion.h
genhdr: $(addprefix $(HEADER_BUILD)/,$(GENHDR))
	mkdir -p genhdr
	cp $^ genhdr/
	# the version is MicroPython's release (tools/micropython.import), not this repo's git
	sed -i 's/GIT_TAG ".*"/GIT_TAG "v1.27.0"/; s/GIT_HASH ".*"/GIT_HASH "78ff170"/' genhdr/mpversion.h
	rm -rf $(BUILD)
.PHONY: genhdr
include $(TOP)/py/mkrules.mk

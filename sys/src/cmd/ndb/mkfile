# cs & dns mkfile
</$objtype/mkfile

TARG =	\
	query\
	cs\
	csquery\
	dns\
	dnsquery\

DNSOBJ = dns.$O dnudpserver.$O dntcpserver.$O dn.$O dnresolve.$O dblookup.$O dnserver.$O dnnotify.$O\
	 dnarea.$O convM2DNS.$O convDNS2M.$O

HFILES = dns.h /$objtype/lib/libndb.a

BIN=/$objtype/bin/ndb

</sys/src/cmd/mkmany

$O.dns: $DNSOBJ
	$LD -o $target $prereq

$O.cs: cs.$O
	$LD -o $target $prereq

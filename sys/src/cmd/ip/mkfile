</$objtype/mkfile

TARG=\
	ping\

DIRS=ipconfig

BIN=/$objtype/bin/ip
HFILES=dhcp.h icmp.h

</sys/src/cmd/mkmany

all:V:	$DIRS

$DIRS:V:
	for (i in $DIRS) @{
		echo mk $i
		cd $i
		mk all
	}

install:V:	installdirs

installdirs:V:
	for (i in $DIRS) @{
		echo mk $i
		cd $i
		mk install
	}

clean:V:
	for (i in $DIRS) @{
		echo clean $i
		cd $i
		mk clean
	}
	rm -f [$OS].* *.[$OS]

nuke:V:
	for (i in $DIRS) @{
		echo nuke $i
		cd $i
		mk nuke
	}
	rm -f *.[$OS] [$OS].$TARG $TARG

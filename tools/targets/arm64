# Plan2001 target: ARM64, UEFI only - planned (phase 4): the values are
# upstream 9front's arm64 port as it is, before Plan2001 takes it over.
status=planned
objtype=arm64
kdir=arm64
kconf=qemu
kernel=9qemu
ksrc=(port arm64 ip boot)
loader=bootaa64.efi
loaderdir=arm64
espname=BOOTAA64.EFI
bootarch=2
qemu=qemu-system-aarch64
# acpi=off: AAVMF then hands over QEMU's device tree (and no ACPI);
# gic-version=3: the kernel drives the GIC by its v3 system registers;
# highmem-ecam=off: pciqemu.c has PCI config space at 0x3F000000 (to do:
# take it from the device tree instead)
qemuargs=(-machine 'virt,acpi=off,gic-version=3,highmem-ecam=off' -cpu cortex-a72)
espdev=(-device 'virtio-blk-pci,disable-legacy=on,drive=esp,bootindex=0')
fwcode=/usr/share/AAVMF/AAVMF_CODE.fd
fwvars=/usr/share/AAVMF/AAVMF_VARS.fd

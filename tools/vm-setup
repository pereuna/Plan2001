#!/bin/bash
# One-time setup of the 9front build VM: check the host, fetch the pinned
# 9front ISO (tools/9front.release) into the cache, and install it into
# base.qcow2 through the serial console - no display, no hands.  Does
# nothing that is already done: an existing ISO is only checksummed, an
# existing base.qcow2 ends the script.
#   PLAN2001_CACHE  default ~/.cache/plan2001
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
. "$here/9front.release"
cache=${PLAN2001_CACHE:-$HOME/.cache/plan2001}
vm=$root/build/vm

missing=
for p in qemu-system-x86 qemu-utils ovmf mtools python3 curl; do
	dpkg -s "$p" >/dev/null 2>&1 || missing="$missing $p"
done
[ -z "$missing" ] || { echo "vm-setup: missing packages; run: sudo apt install$missing" >&2; exit 1; }
[ -r /dev/kvm ] && [ -w /dev/kvm ] || {
	echo "vm-setup: no access to /dev/kvm (sudo adduser $USER kvm, then log in again)" >&2; exit 1; }
for f in /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_VARS_4M.fd; do
	[ -f "$f" ] || { echo "vm-setup: $f missing (package ovmf)" >&2; exit 1; }
done

mkdir -p "$cache"
if [ ! -f "$cache/$ISO" ]; then
	echo "vm-setup: downloading $URL"
	curl -fL -o "$cache/$ISO.gz.part" "$URL"
	echo "$ISO_GZ_SHA256  $cache/$ISO.gz.part" | sha256sum -c --quiet
	gunzip -c "$cache/$ISO.gz.part" > "$cache/$ISO.part"
	rm "$cache/$ISO.gz.part"; mv "$cache/$ISO.part" "$cache/$ISO"
fi
echo "$ISO_SHA256  $cache/$ISO" | sha256sum -c --quiet || { echo "vm-setup: $cache/$ISO: bad checksum" >&2; exit 1; }

if [ -f "$cache/base.qcow2" ]; then
	echo "vm-setup: $cache/base.qcow2 exists, nothing to do"
	exit 0
fi

run9() { "$here/9run" -d "$vm" "$@"; }
halt9() { printf '!now done halting\t!done\n' | run9 -t 60 -s fshalt --dialog -; }
new=$cache/base.qcow2.part
trap '"$here/vm" stop' EXIT
rm -f "$new"; qemu-img create -q -f qcow2 "$new" 20G

echo "vm-setup: installing $NAME into $new (log: $vm/serial.log)"
"$here/vm" start --disk "$new" --iso
# The ISO's loader waits one second after plan9.ini for a key: take it to
# set console=0, so that the kernel, bootrc and rc all use COM1.
run9 -t 180 --dialog - <<'EOF'
!now bootfile=\S+\n	\nconsole=0\nboot
bootargs is .*\] *	''
user\[glenda\]: *	''
vgasize is .*\] *	text
mouseport is .*\] *	''
term% 	!done
EOF
# inst/start with its defaults (cwfs64x, GPT, 9fat, US_Eastern, ...) except
# where it has none.  finish halts and reboots; stop at the halt.
run9 -t 1200 -s inst/start --dialog - <<'EOF'
Task to do \[finish\]: *	finish
!now done halting	!done
Disk to partition .*\[no default\]: *	sdE0
Install mbr or gpt .*\[no default\]: *	gpt
>>> *	w\nq
Plan 9 FAT partition .*\[no default\]: *	/dev/sdE0/9fat
Initialize FAT on EFI system partition .*\[no default\]: *	yes
\[no default\]: *	!fail
.*\[[^]]*\]:? *	''
EOF
"$here/vm" stop

# Boot the installed disk once: the installer wrote console=0 into
# plan9.ini; add the answers to the boot questions, so that every later
# boot goes straight to an rc prompt on COM1.
"$here/vm" start --disk "$new"
run9 -t 180 --dialog - <<'EOF'
bootargs is .*\] *	''
user\[glenda\]: *	''
term% 	!done
EOF
run9 "test -e /srv/dos || dossrv >/dev/null >[2=1]; mount -c /srv/dos /n/9fat /dev/sdE0/9fat"
run9 "{ grep -v '^(nobootprompt|user)=' /n/9fat/plan9.ini; echo 'nobootprompt=local!/dev/sdE0/fscache'; echo 'user=glenda' } >/tmp/p9ini && cp /tmp/p9ini /n/9fat/plan9.ini && cat /n/9fat/plan9.ini"
halt9
"$here/vm" stop

# Check: boots to rc without a single question.
"$here/vm" start --disk "$new"
printf 'term%% \t!done\n' | run9 -t 180 --dialog -
run9 'cat /dev/sysname; echo; ls /dev/sdE1 /dev/sdE2'
halt9
"$here/vm" stop
trap - EXIT
mv "$new" "$cache/base.qcow2"
echo "vm-setup: done, $cache/base.qcow2"

#!/bin/bash
# The repo's Plan 9 files as one tree, in 9front's root layout: plan2001/,
# Plan2001's tree (docs/plan9-wasm32.md) - what is laid over a 9front tree
# (the VM's /sys/src: tools/build.sh, or subset/9front: tools/tree).
# Only the git-tracked files.
#   tools/overlay DIR      DIR made anew
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
[ $# = 1 ] || { echo "usage: tools/overlay DIR" >&2; exit 2; }
out=$1
rm -rf "$out"; mkdir -p "$out"
(cd "$root/plan2001" && git ls-files | tar cf - -T -) | tar xf - -C "$out"

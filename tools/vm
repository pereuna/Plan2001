#!/bin/bash
# Start/stop the 9front build VM (QEMU+KVM+OVMF, no display, no network).
#
#   tools/vm start                  boot a throwaway overlay on base.qcow2
#   tools/vm start --disk FILE      boot FILE itself instead
#   VM_DISK_BPS=N tools/vm start ... the system disk at N bytes/s (a slow
#                                   USB stick, for installer timings)
#   tools/vm start ... --iso ISO    also attach ISO and boot from it
#   tools/vm start ... --scratch F  also attach disk F (qcow2) as sdE3
#   tools/vm start ... --usb IMG    also attach IMG as a USB stick, boot it
#   tools/vm start ... --net        a network (QEMU user mode) with the CPU
#                                   server's ports on the host: rcpu at
#                                   127.0.0.1:17019, auth at 127.0.0.1:5670
#                                   (567 is privileged on the host)
#                                   PLAN2001_LAN=IP: https (17443) on IP too,
#                                   for the machines of the local network
#                                   (tools/vm-cpu names APP.IP.nip.io)
#   tools/vm start ... --oci        the hardware of an Oracle Cloud
#                                   VM.Standard.E2.1.Micro instead: 1 GB,
#                                   the disk on virtio-scsi, legacy
#                                   virtio-net with its MAC and subnet,
#                                   no in.img/out.img
#   tools/vm stop                   quit QEMU; delete the overlay unless KEEP=1
#   tools/vm status
#
# Everything lives in build/vm/: serial.log (-> the log of the current run,
# serial-<time>.log) and the FIFO serial.in, kept by tools/9run's relay on
# QEMU's serial.sock (relay.pid), mon.sock, qemu.pid,
# vm.qcow2 (the overlay), OVMF vars.  Disks, in this order, so that 9front
# names them the same every time:
#   sdE0  system disk             sdE1  build/in.img  (raw tar, sources in)
#   sdE2  build/out.img (raw tar, results out)
#   sdE3  --iso ISO (as sdE3 too, a CD) or --scratch F
# in.img/out.img are created empty if missing (out.img OUT_MB MiB, default
# 64); tools/build.sh fills them.
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
cache=${PLAN2001_CACHE:-$HOME/.cache/plan2001}
vm=$root/build/vm
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd

running() { [ -f "$vm/qemu.pid" ] && kill -0 "$(cat "$vm/qemu.pid")" 2>/dev/null; }

case $1 in
start)
	shift; disk= iso= scratch= usb= net= oci=
	while [ $# -gt 0 ]; do
		case $1 in
		--disk) disk=$2; shift 2 ;;
		--iso) iso=$2; shift 2 ;;
		--scratch) scratch=$2; shift 2 ;;
		--usb) usb=$2; shift 2 ;;
		--net) net=1; shift ;;
		--oci) oci=1; shift ;;
		*) echo "usage: tools/vm start [--disk FILE] [--iso ISO | --scratch FILE] [--usb IMG] [--net]" >&2; exit 2 ;;
		esac
	done
	running && { echo "vm: already running (tools/vm stop first)" >&2; exit 1; }
	[ -r /dev/kvm ] && [ -w /dev/kvm ] || {
		echo "vm: no access to /dev/kvm (add yourself to group kvm and log in again)" >&2; exit 1; }
	mkdir -p "$vm"; rm -f "$vm"/*.sock "$vm/qemu.pid"
	if [ -z "$disk" ]; then
		[ -f "$cache/base.qcow2" ] || { echo "vm: no $cache/base.qcow2 (run tools/vm-setup)" >&2; exit 1; }
		disk=$vm/vm.qcow2; rm -f "$disk"
		qemu-img create -q -f qcow2 -b "$cache/base.qcow2" -F qcow2 "$disk"
	fi
	[ -f "$root/build/in.img" ] || truncate -s 64M "$root/build/in.img"
	[ -f "$root/build/out.img" ] || truncate -s "${OUT_MB:-64}M" "$root/build/out.img"
	cp "$OVMF_VARS" "$vm/vars.fd"
	log=serial-$(date +%Y%m%d-%H%M%S).log
	ln -sfn "$log" "$vm/serial.log"; : > "$vm/$log"
	nic=(-nic none)
	lan=
	[ -n "$PLAN2001_LAN" ] && lan=,hostfwd=tcp:$PLAN2001_LAN:17443-:17443
	[ -n "$net" ] && nic=(-nic user,hostfwd=tcp:127.0.0.1:17019-:17019,hostfwd=tcp:127.0.0.1:5670-:567,hostfwd=tcp:127.0.0.1:17080-:17080,hostfwd=tcp:127.0.0.1:17443-:17443,hostfwd=tcp:127.0.0.1:17010-:17010$lan)
	cd=()
	[ -n "$iso" ] && cd=(-drive file="$iso",if=none,id=cd,media=cdrom,readonly=on -device ide-cd,drive=cd,bus=ide.3,bootindex=0)
	[ -n "$scratch" ] && cd=(-drive file="$scratch",if=none,id=sc,format=qcow2 -device ide-hd,drive=sc,bus=ide.3)
	[ -n "$usb" ] && cd=("${cd[@]}" -device qemu-xhci,id=xhci -drive file="$usb",if=none,id=usb,format=raw \
		-device usb-storage,bus=xhci.0,drive=usb,bootindex=0)
	disks=(-drive file="$disk",if=none,id=hd,format=qcow2${VM_DISK_BPS:+,throttling.bps-total=$VM_DISK_BPS} -device ide-hd,drive=hd,bus=ide.0,bootindex=1
		-drive file="$root/build/in.img",if=none,id=in,format=raw -device ide-hd,drive=in,bus=ide.1
		-drive file="$root/build/out.img",if=none,id=out,format=raw -device ide-hd,drive=out,bus=ide.2)
	mem=2048
	if [ -n "$oci" ]; then
		mem=1024
		disks=(-device virtio-scsi-pci,id=scsi -drive file="$disk",if=none,id=hd,format=qcow2
			-device scsi-hd,drive=hd,bus=scsi.0,lun=${OCI_LUN:-1},bootindex=1)
		# and its network: its MAC (OCI_MAC), 10.0.0.0/24, DHCP from .223
		fwd=${nic[1]#user}
		[ -z "$net" ] && fwd=
		nic=(-netdev "user,id=n0,net=10.0.0.0/24,host=10.0.0.1,dhcpstart=10.0.0.223$fwd"
			-device virtio-net-pci,netdev=n0,disable-modern=on,mac=${OCI_MAC:-02:00:17:00:36:f7})
	fi
	qemu-system-x86_64 -name plan2001-vm -accel kvm -cpu host -machine q35 -m $mem -smp 2 \
		-drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" -drive if=pflash,format=raw,file="$vm/vars.fd" \
		-display none -vga none "${nic[@]}" -rtc base=utc \
		-chardev socket,id=ser,path="$vm/serial.sock",server=on,wait=off -serial chardev:ser \
		-monitor unix:"$vm/mon.sock",server=on,wait=off \
		"${disks[@]}" \
		"${cd[@]}" -daemonize -pidfile "$vm/qemu.pid"
	rm -f "$vm/serial.in"; mkfifo "$vm/serial.in"
	setsid python3 "$here/9run" --relay "$vm" </dev/null >/dev/null 2>&1 &
	echo $! > "$vm/relay.pid"
	;;
stop)
	# QEMU may exit (and remove its pidfile) between the test and the read
	if running && pid=$(cat "$vm/qemu.pid" 2>/dev/null); then
		python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.sendall(b"quit\n"); s.recv(100)' "$vm/mon.sock" 2>/dev/null || true
		for i in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
		kill "$pid" 2>/dev/null || true
	fi
	[ -f "$vm/relay.pid" ] && kill "$(cat "$vm/relay.pid")" 2>/dev/null || true
	rm -f "$vm"/*.sock "$vm/qemu.pid" "$vm/relay.pid" "$vm/serial.in"
	[ "$KEEP" = 1 ] || rm -f "$vm/vm.qcow2"
	;;
status)
	running && echo "running (pid $(cat "$vm/qemu.pid"))" || { echo stopped; exit 1; }
	;;
*)
	echo "usage: tools/vm start|stop|status" >&2; exit 2 ;;
esac

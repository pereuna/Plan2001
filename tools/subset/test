#!/bin/bash
# Acceptance test of the install subset: install 9front from
# build/subset/subset.iso (tools/subset/mkiso) onto a fresh disk with the
# usual answers, then boot the installed disk to an rc prompt
# (tools/vm-install does both).  PASS or FAIL; log in build/vm/serial.log.
set -e
here=$(cd "$(dirname "$0")" && pwd); tools=$(dirname "$here"); root=$(dirname "$tools")
s=$root/build/subset
[ -f "$s/subset.iso" ] || { echo "test: no $s/subset.iso (run tools/subset/mkiso)" >&2; exit 1; }
rm -f "$s/test.qcow2"; qemu-img create -q -f qcow2 "$s/test.qcow2" 20G
if "$tools/vm-install" "$s/subset.iso" "$s/test.qcow2"; then
	echo "PASS: the subset ISO installs a system that boots to rc"
else
	echo "FAIL: see $root/build/vm/serial.log"; exit 1
fi

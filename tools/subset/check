#!/bin/bash
# Does the copy in subset/9front still match the pinned 9front release?
# Compares the md5 of every copied file (subset/files) with the file in the
# VM's tree (a fresh overlay of base.qcow2) and with the file in the repo.
set -e
here=$(cd "$(dirname "$0")" && pwd); tools=$(dirname "$here"); root=$(dirname "$tools")
b=$root/build; s=$b/subset/check
run9() { "$tools/9run" -d "$b/vm" "$@"; }
rm -rf "$s" "$b/in.img" "$b/out.img"; mkdir -p "$s"
awk -F'\t' '!/^#/ && $5 != "-" { sub(/^\//, "", $1); print $1 }' "$root/subset/files" > "$s/want"
tar cf "$b/in.img" --format=ustar -C "$here" check.rc -C "$s" want; truncate -s 64M "$b/in.img"
trap '"$tools/vm" stop' EXIT
"$tools/vm" start
printf 'term%% \t!done\n' | run9 -t 180 --dialog - >/dev/null
run9 -t 600 '@{cd /tmp && tar xf /dev/sdE1/data check.rc} && rc /tmp/check.rc'
"$tools/vm" stop; trap - EXIT
tar xmf "$b/out.img" -C "$s"
python3 - "$root" "$s" <<'PY'
import hashlib, sys
root, s = sys.argv[1:]
vm = {}
for l in open(s + '/md5'):
	m, p = l.split(None, 1)
	vm['/' + p.strip()] = m
bad = 0
for l in open(root + '/subset/files'):
	if l.startswith('#'):
		continue
	p, kind, how, why, m = l.rstrip('\n').split('\t')
	if m == '-':
		continue
	repo = hashlib.md5(open(root + '/subset/9front' + p, 'rb').read()).hexdigest()
	if vm.get(p) != m or repo != m:
		bad += 1
		print('differs: %s (list %s, vm %s, repo %s)' % (p, m, vm.get(p), repo))
n = sum(1 for l in open(root + '/subset/files') if not l.startswith('#') and not l.rstrip('\n').endswith('\t-'))
print('check: %d files, %d differ' % (n, bad))
sys.exit(1 if bad else 0)
PY

#!/bin/bash
# Build a target's Plan2001 USB install medium from subset/$TARGET/proto and
# this repo's own loader and kernel for it (build/$TARGET, from
# tools/build.sh): build/subset/$TARGET/plan2001-inst.img, a raw disk image
# to dd onto a USB stick.  Booted by UEFI only (see mkusb.rc).
set -e
here=$(cd "$(dirname "$0")" && pwd); tools=$(dirname "$here"); root=$(dirname "$tools")
. "$tools/target.sh"
b=$root/build; s=$b/subset/$TARGET
run9() { "$tools/9run" -d "$b/vm" "$@"; }
for f in "$kernel" "$loader"; do
	[ -s "$tbuild/$f" ] || { echo "mkusb: no $tbuild/$f (run tools/build.sh)" >&2; exit 1; }
done
mkdir -p "$s"; rm -f "$b/in.img" "$b/out.img" "$s/plan2001-inst.img"
cp "$tools/targets/$TARGET" "$s/target"
tar cf "$b/in.img" --format=ustar -C "$here" mkusb.rc -C "$root/subset/$TARGET" proto -C "$tbuild" "$kernel" "$loader" -C "$s" target
truncate -s 64M "$b/in.img"
export OUT_MB=${USB_MB:-1024}
trap '"$tools/vm" stop' EXIT
"$tools/vm" start
printf 'term%% \t!done\n' | run9 -t 180 --dialog - >/dev/null
run9 -t 900 '@{cd /tmp && tar xf /dev/sdE1/data mkusb.rc} && rc /tmp/mkusb.rc' | tail -30
"$tools/vm" stop; trap - EXIT
grep -q MKUSB-DONE "$b/vm/serial.log" || { echo "mkusb failed" >&2; exit 1; }
mv "$b/out.img" "$s/plan2001-inst.img"
echo "mkusb: $s/plan2001-inst.img ($OUT_MB MiB, $(du -h "$s/plan2001-inst.img" | cut -f1) used)"

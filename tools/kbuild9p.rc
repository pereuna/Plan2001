#!/bin/rc
# Builds a target's kernel ON a Plan2001/9front CPU server through a
# 9pterm session, the sources straight from the client's repo at
# /mnt/term (no tar, no disk images): the same overlay as tools/build.rc.
#   9pterm -S SOCK -T 900 -c 'rc /mnt/term/PATH/TO/Plan2001/tools/kbuild9p.rc /mnt/term/PATH/TO/Plan2001 [target [stockkbd|syskbd] [pool]]'
# pool: the compiles go to the compute pool (rcc: the browsers' CRs,
# docs/cpu-server-design.md) when it has CRs, else here
# The kernel lands in the repo's build/$target/ as $kernel.
rfork en
repo=$1
if(~ $#repo 0){
	echo usage: kbuild9p.rc REPO '[target]' >[1=2]
	exit usage
}
target=$2
if(~ $#target 0)
	target=amd64
. $repo/tools/targets/$target
d=/tmp/kbuild9p.$pid
rm -rf $d
mkdir -p $d/9 $d/inc $d/auxbin $d/kbdfs
fn cleanup { rm -rf $d }

cp $repo/sys/include/bootinfo.h $d/inc/bootinfo.h
bind -b $d/inc /sys/include

echo '### overlay '^$"ksrc^' from '^$repo
dircp /sys/src/9 $d/9
for(x in $ksrc) if(test -d $repo/sys/src/9/$x) dircp $repo/sys/src/9/$x $d/9/$x
for(f in `{ls $repo/sys/src/9/port})
	for(x in $ksrc) if(! ~ $x port) rm -f $d/9/$x/`{basename $f}

echo '### kbdfs'
dircp /sys/src/cmd/aux/kbdfs $d/kbdfs
# stockkbd: 9front's own kbdfs, from the repo's 9front subset (the
# server's source may hold the line editor already)
if(~ $3 stockkbd)
	cp $repo/subset/9front/sys/src/cmd/aux/kbdfs/kbdfs.c $d/kbdfs/kbdfs.c
if not
	cp $repo/sys/src/cmd/aux/kbdfs/kbdfs.c $d/kbdfs/kbdfs.c
@{ cd $d/kbdfs && rm -f *.[0-9ko] ?.out && mk >[2=1] } >$d/kbdfs.log
o=`{ls -t $d/kbdfs/?.out >[2]/dev/null}
if(~ $#o 0){
	tail -20 $d/kbdfs.log
	echo KBDFS BUILD FAILED
	cleanup
	exit kbdfs
}
cp $o(1) $d/auxbin/kbdfs
if(~ $3 syskbd)
	cp /$objtype/bin/aux/kbdfs $d/auxbin/kbdfs
# aux/reimage: the boot environment rewrites the disk from the network
# (sys/src/9/boot/reimage.rc, devsd.proto)
if(test -e $repo/sys/src/cmd/aux/reimage.c){
	@{ cd $d/auxbin && cp $repo/sys/src/cmd/aux/reimage.c . && 6c -FTVw reimage.c && 6l -o reimage reimage.6 && rm -f reimage.c reimage.6 } || {
		echo REIMAGE BUILD FAILED
		cleanup
		exit reimage
	}
	chmod 775 $d/auxbin/reimage
}
# bootfs.paq takes the modes of what it is made from, the directory too
# (bin/aux is this union, $d/auxbin first), and files made under /tmp
# here are 0750: bootrc's test -x /bin/aux/kbdfs, made before the host
# owner is set, then fails, no kbdfs starts, and a terminal's console
# reads nothing but EOF
chmod 775 $d/auxbin $d/auxbin/kbdfs
bind -b $d/auxbin /$objtype/bin/aux

echo '### kernel '^$kconf
mkargs=()
if(~ pool $*(3-)){
	test -e /compute/status || mount -c /srv/compute /compute >[2]/dev/null
	crs=`{awk '{print $2}' /compute/status >[2]/dev/null}
	if(! ~ $#crs 0 && ! ~ $crs 0){
		mkargs=('CC=rcc')
		NPROC=64
		echo pool: $crs CRs
	}
	if not
		echo pool: no CRs, compiling here
}
bind -c $d/9 /sys/src/9
cd /sys/src/9/$kdir
time mk 'CONF='$kconf $mkargs >$d/kernel.log >[2=1]
st=$status
mkdir -p $repo/build/$target
cp $d/kernel.log $repo/build/$target/kernel9p.log
if(! ~ $st '' || ! test -f $kernel){
	grep -v '^(6c|6a|8c|8a|cc|ar|mk|cp|rm|echo|size) ' $d/kernel.log | tail -40
	echo KERNEL BUILD FAILED
	cd /
	cleanup
	exit kernel
}
# bootrc starts the kbdfs in bootfs.paq: it must be the one built here
mkdir -p $d/paq
paqfs -m $d/paq $kconf.bootfs.paq
paqsum=`{md5sum <$d/paq/$objtype/bin/aux/kbdfs}
kbdsum=`{md5sum <$d/auxbin/kbdfs}
ls -l $d/paq/$objtype/bin/aux $d/paq/$objtype/bin/rc $d/paq/rc/bin/bootrc
# bootrc runs kbdfs only if all may: else a terminal's console is dead
for(f in $objtype/bin $objtype/bin/aux $objtype/bin/aux/kbdfs){
	m=`{ls -ld $d/paq/$f | awk '{print $1}'}
	if(! ~ $m *x){
		unmount $d/paq
		echo BOOTFS $f NOT OPEN TO ALL: $m
		cd /
		cleanup
		exit bootfs-mode
	}
}
unmount $d/paq
echo kbdfs built $kbdsum in bootfs.paq $paqsum
size $kernel
cp $kernel $repo/build/$target/$kernel
md5sum $kernel
cd /
cleanup
echo KBUILD-DONE

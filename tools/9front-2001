#!/bin/bash
# 9Front-2001 (docs/plan9-fork.md): 9front's release as the repo has it
# (subset/9front), with the fork's patches to 9front's own files
# (plan9/patches/9front/*.diff, patch -p1 from the root, each must apply
# to the release as it is) and the fork laid over it (plan9/: new files,
# and the patched files again, which must be the same).  The tree in 9front's root
# layout: /sys, /rc, /$objtype ... for a 9front machine's /, or the native
# build here (tools/native-wasm32).  Only the git-tracked files of the fork.
#   tools/9front-2001 [DIR]     default build/9front-2001, made anew
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
out=${1:-$root/build/9front-2001}
rm -rf "$out"; mkdir -p "$out"
cp -a "$root/subset/9front/." "$out/"
for p in "$root"/plan9/patches/9front/*.diff; do
	patch -s -p1 -d "$out" <"$p" || { echo "9front-2001: $(basename "$p") does not apply to subset/9front" >&2; exit 1; }
done
fork=$(mktemp -d)
trap 'rm -rf "$fork"' EXIT
"$here/overlay" -f "$fork/t"
# each patched file is also in the fork, the same (plan9/patches/9front/README):
# the VM's build lays the fork over its /sys/src without the patches
for p in "$root"/plan9/patches/9front/*.diff; do
	for f in $(sed -n 's|^+++ b/\([^	 ]*\).*|\1|p' "$p"); do
		cmp -s "$out/$f" "$fork/t/$f" || { echo "9front-2001: plan9/$f is not $(basename "$p") applied to subset/9front's" >&2; exit 1; }
	done
done
cp -a "$fork/t/." "$out/"
# what the release ships made from another file (libsec's X.c and
# libauthsrv's X.mpc from X.mp, by mpc) newer than it, as on a 9front machine: a checkout's mtimes are
# in any order, and mk would make it again with a tool the host lacks
find "$out" -name '*.mp' | while read -r m; do
	for g in "${m%.mp}.c" "${m}c"; do [ ! -e "$g" ] || touch "$g"; done
done
echo "9front-2001: $out ($(ls "$root"/plan9/patches/9front/*.diff | wc -l) patches, $(cd "$root/plan9" && git ls-files | grep -vc '^patches/') fork files)"

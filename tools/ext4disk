#!/bin/bash
# A disk for booting Plan2001 with its root in the kernel's ext4 (#E): GPT,
# an ESP (the loader as EFI/BOOT, the kernel, plan9.ini) and the ext4 root
# (tools/ext4root), found by its uuid.  plan9.ini has root=UUID=... and
# user=glenda: the kernel mounts the root and runs its init
# (docs/init.md).  dd it to a USB stick for real hardware;
# tools/test-ext4.sh boots it in QEMU.
#   tools/ext4disk [OUT]      default build/$TARGET/ext4disk.img
#   CONSOLE=0                 the serial console (plan9.ini console=0);
#                             without it the machine's screen and keyboard
#   NOROOT=1                  use build/$TARGET/root.ext4 as it is
#   ROOT=UUID=uuid!/dir       the root is elsewhere (a Linux file system on
#                             the machine's own disk): only the ESP
#   RW=1                      the root written (root=-w ...)
#   INIT=/init                plan9.ini init= (default the kernel's:
#                             /$objtype/init -t)
#   ESPDIR=EFI/BOOT           plan9.ini and the kernel in the loader's
#                             directory, not the ESP's root (the loader
#                             looks there first: as in another system's
#                             ESP, \EFI\plan2001 chainloaded by GRUB)
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
. "$here/target.sh"
b=$tbuild
out=${1:-$b/ext4disk.img}
for f in "$b/$kernel" "$b/$loader"; do
	[ -s "$f" ] || { echo "ext4disk: no $f (tools/build.sh)" >&2; exit 1; }
done
if [ -z "$ROOT" ]; then
	[ "${NOROOT:-0}" = 1 ] && [ -s "$b/root.ext4" ] || "$here/ext4root"
	dir=$(cat "$b/root.dir" 2>/dev/null || true)
	ROOT=UUID=$(cat "$b/root.uuid")${dir:+!$dir}
	rootimg=$b/root.ext4
fi

esp=$b/ext4esp.img
rm -f "$esp"
{
	printf 'bootfile=/%s\n' "${ESPDIR:+$ESPDIR/}$kernel"
	[ -n "$CONSOLE" ] && printf 'console=%s\n' "$CONSOLE"
	printf 'user=glenda\nroot=%s%s\n' "${RW:+-w }" "$ROOT"
	[ -n "$INIT" ] && printf 'init=%s\n' "$INIT"
} > "$b/ext4plan9.ini"
mformat -C -i "$esp" -T 131072 -h 64 -s 32 ::
mmd -i "$esp" ::/EFI ::/EFI/BOOT
mcopy -i "$esp" "$b/$loader" "::/EFI/BOOT/$espname"
mcopy -i "$esp" "$b/$kernel" ::/${ESPDIR:+$ESPDIR/}
mcopy -i "$esp" "$b/ext4plan9.ini" ::/${ESPDIR:+$ESPDIR/}plan9.ini

# 1 MiB, the ESP (64 MiB), the root, 1 MiB for the backup GPT
rmib=0
[ -n "$rootimg" ] && rmib=$(( ($(stat -c %s "$rootimg") + 1048575) / 1048576 ))
rm -f "$out"
truncate -s $((1 + 64 + rmib + 1))M "$out"
parted=$(command -v parted || echo /sbin/parted)
"$parted" -s "$out" mklabel gpt mkpart ESP fat32 1MiB 65MiB set 1 esp on
[ -n "$rootimg" ] && "$parted" -s "$out" mkpart plan2001 ext4 65MiB $((65 + rmib))MiB
dd if="$esp" of="$out" bs=1M seek=1 conv=notrunc status=none
[ -n "$rootimg" ] && dd if="$rootimg" of="$out" bs=1M seek=65 conv=notrunc status=none
echo "ext4disk: $out ($(( $(stat -c %s "$out") / 1048576 )) MiB), root $ROOT"

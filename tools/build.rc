#!/bin/rc
# Runs ON the 9front VM (tools/build.sh starts it with tools/9run).
# Builds a target's kernel and UEFI loader from the VM's own /sys/src with
# this repo's changed files (sys/...) laid over it - the VM's sources are
# the base, we only touch what we actually changed.
# Sources come in as a tar stream on /dev/sdE1 (this repo's sys/, this
# script and the target, tools/targets/$TARGET as /tmp/target), results go
# out the same way on /dev/sdE2 (see tools/vm).
rfork en
. /tmp/target
d=/usr/glenda/plan2001build
rm -rf $d
mkdir -p $d/9 $d/efi $d/inc $d/src $d/out
@{cd $d/src && tar xf /dev/sdE1/data}
hostsrc=$d/src
hostbuild=$d/out

echo '### kernel: overlay '^$"ksrc^' from the repo onto the VM tree'
dircp /sys/src/9 $d/9
for(x in $ksrc) if(test -d $hostsrc/sys/src/9/$x) dircp $hostsrc/sys/src/9/$x $d/9/$x
# a file this repo moved to port/ must not also be found in pc/ (the
# kernel mkfile has a rule for each directory): drop the VM's pc/ copy
for(f in `{ls $hostsrc/sys/src/9/port})
	rm -f $d/9/pc/`{basename $f}

echo '### kbdfs: build the line-editing console server (goes into bootfs.paq)'
mkdir -p $d/auxbin $d/kbdfs
dircp /sys/src/cmd/aux/kbdfs $d/kbdfs
cp $hostsrc/sys/src/cmd/aux/kbdfs/kbdfs.c $d/kbdfs/kbdfs.c
@{
	cd $d/kbdfs
	mk >$d/kbdfs.log >[2=1]
}
o=`{ls $d/kbdfs/?.out >[2]/dev/null}
if(~ $#o 0){
	tail -20 $d/kbdfs.log
	echo KBDFS BUILD FAILED
	exit kbdfs-build-failed
}
cp $d/kbdfs.log $hostbuild/kbdfs.log
cp $o $d/auxbin/kbdfs
bind -b $d/auxbin /$objtype/bin/aux
cp $hostsrc/sys/include/bootinfo.h $d/inc/bootinfo.h
bind -b $d/inc /sys/include
bind -c $d/9 /sys/src/9
cd /sys/src/9/$kdir
time mk 'CONF='$kconf >$d/kernel.log >[2=1]
st = $status
echo kernel mk status: $st
tail -3 $d/kernel.log
cp $d/kernel.log $hostbuild/kernel.log
if(! ~ $st '' || ! test -f $kernel){
	echo KERNEL BUILD FAILED
	exit kernel-build-failed
}
size $kernel
md5sum $kernel
cp $kernel $hostbuild/$kernel

echo '### loader: overlay our changed boot/efi files onto the VM tree'
dircp /sys/src/boot/efi $d/efi
dircp $hostsrc/sys/src/boot/efi $d/efi
bind -c $d/efi /sys/src/boot/efi
cd /sys/src/boot/efi
mk $loader >$d/loader.log >[2=1]
st = $status
echo loader mk status: $st
cp $d/loader.log $hostbuild/loader.log
if(! ~ $st '' || ! test -f $loader){
	echo LOADER BUILD FAILED
	exit loader-build-failed
}
md5sum $loader
cp $loader $hostbuild/$loader

@{cd $hostbuild && tar c .} >/dev/sdE2/data
echo BUILD-DONE

#!/usr/bin/env python3
"""Compare address ownership sets in two complete offline audit logs."""
import json
from pathlib import Path
import re
import sys

BLK=16384

def read(path):
    text=Path(path).read_text()
    if 'audit complete: yes' not in text:
        raise ValueError('incomplete audit: '+str(path))
    sets={}
    for k,a,b in re.findall(r'^audit owned-range: kind=(\w+) start=([0-9a-f]+) end=([0-9a-f]+)',text,re.M):
        sets.setdefault(k,set()).update(range(int(a,16),int(b,16),BLK))
    if not sets: raise ValueError('audit lacks exported ownership sets')
    unknown=set()
    for a,b in re.findall(r'^audit range: start=([0-9a-f]+) end=([0-9a-f]+)',text,re.M):
        unknown.update(range(int(a,16),int(b,16),BLK))
    sets['unaccounted']=unknown
    return sets

def main():
    if len(sys.argv)!=3: sys.exit('usage: tools/gefs-audit-compare BEFORE_LOG AFTER_LOG')
    before,after=map(read,sys.argv[1:])
    new=after['unaccounted']-before['unaccounted']
    result=dict(before=sys.argv[1],after=sys.argv[2],new_unaccounted=len(new),
                no_longer_unaccounted=len(before['unaccounted']-after['unaccounted']),
                previous_kinds={k:len(v & new) for k,v in before.items() if k!='unaccounted'})
    print(json.dumps(result,indent=2))

if __name__=='__main__':main()

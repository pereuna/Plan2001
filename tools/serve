#!/bin/bash
# Development server for the browser drawterm, loopback only:
#   http://127.0.0.1:8080/  web/ and build/wasm/drawterm.{js,wasm}, with the
#                           COOP/COEP headers that pthreads need
#   ws://127.0.0.1:8081     Emscripten's websocket_to_posix_proxy: the page's
#                           POSIX sockets, i.e. rcpu and auth to the Plan2001
#                           VM (tools/vm --net in the Plan2001 repo)
# The proxy is built from Emscripten's source, patched to listen on
# 127.0.0.1 instead of every interface (it connects anywhere it is told).
# Phase 2 replaces it with Plan2001's own WSS listener.
#   tools/serve [HTTPPORT [PROXYPORT]]
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
http=${1:-8080} ws=${2:-8081}
proxy=$root/build/proxy/websocket_to_posix_proxy
src=${EMSCRIPTEN_ROOT:-/usr/share/emscripten}/tools/websocket_to_posix_proxy/src
if [ ! -x "$proxy" ]; then
	mkdir -p "$root/build/proxy/src"
	cp "$src"/* "$root/build/proxy/src/"
	sed -i 's/htonl(INADDR_ANY)/htonl(INADDR_LOOPBACK)/' "$root/build/proxy/src/main.cpp"
	grep -q INADDR_LOOPBACK "$root/build/proxy/src/main.cpp" || { echo "serve: could not patch the proxy to loopback" >&2; exit 1; }
	(cd "$root/build/proxy/src" && gcc -O2 -c *.c && g++ -O2 -pthread -o "$proxy" *.cpp *.o)
fi
site=$root/build/site
mkdir -p "$site"
ln -sfn "$root"/web/* "$site/"
ln -sfn "$root/build/wasm/drawterm.js" "$root/build/wasm/drawterm.wasm" "$site/"

cd "$site"
pids=
trap 'kill $pids 2>/dev/null' EXIT
trap 'exit 1' INT TERM
stdbuf -oL "$proxy" "$ws" >"$root/build/proxy.log" 2>&1 &
pids="$pids $!"
python3 - "$http" <<'PY' &
import http.server, sys
class H(http.server.SimpleHTTPRequestHandler):
	def end_headers(self):
		self.send_header('Cross-Origin-Opener-Policy', 'same-origin')
		self.send_header('Cross-Origin-Embedder-Policy', 'require-corp')
		self.send_header('Cache-Control', 'no-store')
		super().end_headers()
	def log_message(self, *a):
		pass
H.extensions_map['.wasm'] = 'application/wasm'
http.server.ThreadingHTTPServer(('127.0.0.1', int(sys.argv[1])), H).serve_forever()
PY
pids="$pids $!"
echo "serve: http://127.0.0.1:$http/  proxy ws://127.0.0.1:$ws"
wait -n

#!/bin/bash
# Build drawterm.wasm and install the page in the Plan2001 CPU VM, which
# then serves it itself: https://127.0.0.1:17443/ (webterm behind tlssrv,
# wss on the same origin).  Restarts the VM.
#   tools/deploy        PLAN2001 (default ../Plan2001) is the Plan2001 repo;
#                       CPU_CERT_SANS as for its tools/vm-cpu
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
plan2001=${PLAN2001:-$(dirname "$root")/Plan2001}
"$root/tools/build" wasm
site=$root/build/deploy
rm -rf "$site"; mkdir -p "$site"
cp "$root"/web/* "$root/build/wasm/drawterm.js" "$root/build/wasm/drawterm.wasm" "$site/"
"$plan2001/tools/vm-cpu" --update --web "$site"
echo "deploy: https://127.0.0.1:17443/"

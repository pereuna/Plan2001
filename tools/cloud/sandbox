#!/bin/bash
# The public diskless sandbox, https://plan2001.com (docs/cloud.md): the
# wasm32 machine's page (monolith/tools/pages) built here and installed on
# the cloud server over the administrators' WireGuard tunnel
# (tools/cloud/wg-admin up) by sandbox.rc there.
#   tools/cloud/sandbox [ADMIN-IP]
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$(dirname "$here")")
admin=${1:-10.201.0.1}
sec=${PLAN2001_CACHE:-$HOME/.cache/plan2001}/cloud
m=$root/monolith
T=$m/build/9pterm/9pterm
p9() { "$T" -h "$admin" -a "tcp!$admin!567" -u admin -P "$sec/admin.pass" -W 20 -T "${TMO:-300}" -c "$1"; }
site=$root/build/sandbox
"$m/tools/pages" "$site"
out=$(p9 "rc /mnt/term$here/sandbox.rc /mnt/term$root /mnt/term$site" 2>&1 || true)
echo "$out"
echo "$out" | grep -q SANDBOX-DONE || { echo "sandbox: not installed" >&2; exit 1; }
echo "sandbox: https://plan2001.com/"

#!/bin/rc
# Runs ON the 9front VM (sent by build-full.sh through rcpu).
# Builds the full pc64 kernel from the VM's own /sys/src/9 with the repo's
# pc64/, pc/ and port/ laid over it (they are byte-identical to the VM's
# except for our changes) and sys/include/bootinfo.h added.
# $hostsrc   the repo's 9front-x64-boot tree seen through drawterm's /mnt/term
# $hostbuild the host directory that receives the result
rfork n
d=/usr/glenda/fullbuild
rm -rf $d
mkdir -p $d/9 $d/inc
echo '### copy the VM /sys/src/9 and overlay pc64, pc, port from the repo'
dircp /sys/src/9 $d/9
for(x in pc64 pc port) dircp $hostsrc/sys/src/9/$x $d/9/$x
cp $hostsrc/sys/include/bootinfo.h $d/inc/bootinfo.h
bind -b $d/inc /sys/include
bind $d/9 /sys/src/9
cd /sys/src/9/pc64
time mk >$d/mk.log >[2=1]
echo full kernel mk status: $status
tail -3 $d/mk.log
if(test -f 9pc64) {
	size 9pc64
	md5sum 9pc64
	cp 9pc64 $hostbuild/9pc64-full
}
cp $d/mk.log $hostbuild/full-kernel.log
echo BUILD-DONE

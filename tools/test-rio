#!/usr/bin/env python3
"""Phase 1c acceptance: rio in headless Chromium, driven like a user.

  tools/test-rio [--mobile] [--slow] [URL-QUERY]

Starts tools/serve and Chromium with the DevTools protocol, opens the page
(drawterm's console on the Plan2001 CPU VM), types 'rio', opens a window
from rio's button-3 menu (New, then sweep), types a command into it and
saves screenshots to build/rio-*.png.  Input goes through the page's own
event queue (window.monolith.push), the same path as real events.
--mobile emulates a phone: touch events on the screen and the button bar
(button 3 for the menu and the sweep), and text typed through the
on-screen keyboard's path (Input.insertText, as an IME does), with a
backspace; screenshots build/rio-mobile-*.png.  --slow throttles the
CPU 6x and adds 300 ms latency (1 Mbit/s).
Needs the VM running and its password in ~/.cache/plan2001/cpu.pass.
"""
import base64, json, os, socket, struct, subprocess, sys, tempfile, time, urllib.parse, urllib.request

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
cache = os.environ.get('PLAN2001_CACHE', os.path.expanduser('~/.cache/plan2001'))
password = open(os.path.join(cache, 'cpu.pass')).read().strip()
HTTP, PROXY, DEVTOOLS = 18080, 18081, 19222
Evmouse, Evkey = 1, 2
B1, B2, B3 = 1, 2, 4


class Cdp:
	"""The DevTools protocol over a minimal WebSocket client (text frames)."""
	def __init__(self, url):
		u = urllib.parse.urlparse(url)
		self.s = socket.create_connection((u.hostname, u.port))
		key = base64.b64encode(os.urandom(16)).decode()
		self.s.sendall((f'GET {u.path} HTTP/1.1\r\nHost: {u.netloc}\r\nUpgrade: websocket\r\n'
			f'Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n').encode())
		resp = b''
		while b'\r\n\r\n' not in resp:
			resp += self.s.recv(1)
		if b' 101 ' not in resp.split(b'\r\n')[0]:
			raise SystemExit(f'test-rio: DevTools handshake: {resp[:80]}')
		self.id = 0

	def read(self, n):
		b = b''
		while len(b) < n:
			x = self.s.recv(n - len(b))
			if not x:
				raise SystemExit('test-rio: DevTools connection closed')
			b += x
		return b

	def send(self, text):
		data = text.encode()
		n = len(data)
		hdr = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else
			bytes([0x80 | 126]) + struct.pack('>H', n) if n < 65536 else
			bytes([0x80 | 127]) + struct.pack('>Q', n))
		mask = os.urandom(4)
		self.s.sendall(hdr + mask + bytes(c ^ mask[i % 4] for i, c in enumerate(data)))

	def recv(self):
		msg = b''
		while True:
			b0, b1 = self.read(2)
			n = b1 & 0x7f
			if n == 126:
				n = struct.unpack('>H', self.read(2))[0]
			elif n == 127:
				n = struct.unpack('>Q', self.read(8))[0]
			data = self.read(n)
			if b0 & 0x0f in (1, 2, 0):
				msg += data
				if b0 & 0x80:
					return msg

	def call(self, method, **params):
		self.id += 1
		self.send(json.dumps({'id': self.id, 'method': method, 'params': params}))
		while True:
			r = json.loads(self.recv())
			if r.get('id') == self.id:
				if 'error' in r:
					raise RuntimeError(f'{method}: {r["error"]}')
				return r.get('result', {})

	def js(self, expr):
		r = self.call('Runtime.evaluate', expression=expr, returnByValue=True)
		return r.get('result', {}).get('value')


def wait(cdp, expr, secs, what):
	end = time.time() + secs
	while time.time() < end:
		if cdp.js(expr):
			return
		time.sleep(0.5)
	st = cdp.js("(document.getElementById('status') || {}).textContent")
	raise SystemExit(f'test-rio: timed out waiting for {what} (page: {st!r})')


def main():
	argv = sys.argv[1:]
	mobile = '--mobile' in argv
	slow = '--slow' in argv
	argv = [a for a in argv if a not in ('--mobile', '--slow')]
	query = argv[0] if argv else ''
	tmp = tempfile.mkdtemp()
	serve = subprocess.Popen([os.path.join(root, 'tools/serve'), str(HTTP), str(PROXY)],
		stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	chrome = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-gpu',
		f'--user-data-dir={tmp}', f'--remote-debugging-port={DEVTOOLS}',
		'--window-size=1024,768', 'about:blank'],
		stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	try:
		for _ in range(50):
			try:
				pages = json.load(urllib.request.urlopen(f'http://127.0.0.1:{DEVTOOLS}/json'))
				page = next(p for p in pages if p['type'] == 'page')
				break
			except Exception:
				time.sleep(0.2)
		cdp = Cdp(page['webSocketDebuggerUrl'])
		cdp.call('Page.enable')
		if mobile:	# a Pixel 7
			cdp.call('Emulation.setDeviceMetricsOverride', width=412, height=915,
				deviceScaleFactor=2.625, mobile=True)
			cdp.call('Emulation.setTouchEmulationEnabled', enabled=True, maxTouchPoints=5)
		if slow:	# a phone behind a slow tunnel: 6x slower CPU, 300 ms each way
			cdp.call('Network.enable')
			cdp.call('Network.emulateNetworkConditions', offline=False, latency=300,
				downloadThroughput=100_000 // 8 * 10, uploadThroughput=100_000 // 8 * 10)
			cdp.call('Emulation.setCPUThrottlingRate', rate=6)
		url = f'http://127.0.0.1:{HTTP}/index.html?bridge=ws://127.0.0.1:{PROXY}&{query}#pass={password}'
		cdp.call('Page.navigate', url=url)
		prefix = 'mobile-' if mobile else ''

		def push(*ev):
			cdp.js(f'window.monolith.push({",".join(map(str, ev))})')

		def mouse(x, y, b):
			push(Evmouse, x, y, b)
			time.sleep(0.05)

		def touch(kind, x=0, y=0):
			pts = [] if kind == 'touchEnd' else [{'x': x, 'y': y}]
			cdp.call('Input.dispatchTouchEvent', type=kind, touchPoints=pts)
			time.sleep(0.05)

		def tapbar(sel):
			r = cdp.js(f'(() => {{ const r = document.querySelector({json.dumps(sel)}).getBoundingClientRect(); '
				f'return [r.x + r.width/2, r.y + r.height/2]; }})()')
			touch('touchStart', *r)
			touch('touchEnd')
			time.sleep(0.2)

		# at typing speed: drawterm drops keys when its queue to the remote
		# rio is full, as with any drawterm
		def type(s):
			if mobile:
				for c in s:
					cdp.call('Input.insertText', text=c)
					time.sleep(0.04)
			else:
				cdp.call('Runtime.evaluate', awaitPromise=True, expression=
					f'(async () => {{ for (const c of {json.dumps(s)}) {{ const r = c.codePointAt(0); '
					f'window.monolith.push({Evkey}, r, 1, 0); window.monolith.push({Evkey}, r, 0, 0); '
					f'await new Promise(t => setTimeout(t, 40)); }} }})()')
			time.sleep(0.5)

		def backspace():
			for kind in ('keyDown', 'keyUp'):
				cdp.call('Input.dispatchKeyEvent', type=kind, key='Backspace', code='Backspace',
					windowsVirtualKeyCode=8, nativeVirtualKeyCode=8)
			time.sleep(0.3)

		def shot(name):
			png = cdp.call('Page.captureScreenshot', format='png')['data']
			path = os.path.join(root, 'build', f'rio-{prefix}{name}.png')
			open(path, 'wb').write(base64.b64decode(png))
			print(f'test-rio: {name}: build/rio-{prefix}{name}.png')

		def settle(t0):
			for _ in range(60):
				f = cdp.js('window.monolith.flushes')
				time.sleep(1)
				if cdp.js('window.monolith.flushes') == f:
					break
			print(f'test-rio: typed line settled in {time.time() - t0 - 1:.1f}s')

		wait(cdp, 'window.monolith && window.monolith.flushes > 0', 180, "drawterm's console")
		time.sleep(8)	# until rc's prompt (the profile runs first)
		shot('console')
		if mobile:
			tapbar('#showkbd')
			if not cdp.js("document.activeElement.id === 'kbd'"):
				raise SystemExit('test-rio: the keyboard button did not focus the textarea')
		type('rio\n')
		time.sleep(5)
		shot('rio')
		if mobile:
			tapbar('#showkbd')		# keyboard away
			# button 3 menu: New is under the finger the first time; then sweep
			tapbar('[data-b="4"]')
			touch('touchStart', 200, 200)
			time.sleep(0.5)
			touch('touchEnd')
			time.sleep(0.5)
			tapbar('[data-b="4"]')
			touch('touchStart', 20, 40)
			for i in range(1, 11):
				touch('touchMove', 20 + 37*i, 40 + 36*i)
			touch('touchEnd')
			time.sleep(3)
			if cdp.js("document.querySelector('[data-b=\"1\"]').classList.contains('on')") is not True:
				raise SystemExit('test-rio: the bar did not go back to button 1 after a touch')
			tapbar('#showkbd')
			t0 = time.time()
			type('echo MONOLITH-OX')
			backspace()
			type('K; cat /dev/sysname; echo\n')
		else:
			# button 3 menu: New is under the pointer the first time; then sweep
			mouse(300, 200, 0)
			mouse(300, 200, B3)
			time.sleep(0.5)
			mouse(300, 200, 0)
			time.sleep(0.5)
			mouse(60, 60, 0)
			mouse(60, 60, B3)
			for i in range(1, 11):
				mouse(60 + 60*i, 60 + 35*i, B3)
			mouse(660, 410, 0)
			time.sleep(3)
			mouse(300, 200, 0)
			t0 = time.time()
			type('echo MONOLITH-OK; cat /dev/sysname; echo\n')
		settle(t0)
		shot('window')
		n = cdp.js('window.monolith.flushes')
		print(f'test-rio: {n} flushes')
	finally:
		chrome.terminate()
		serve.terminate()
		chrome.wait()
		serve.wait()


main()

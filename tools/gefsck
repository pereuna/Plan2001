#!/bin/bash
# A gefs partition image checked in the build VM (tools/vm) with the
# root tree's own gefs (build/selfroot/amd64/bin/gefs): gefs -c, then
# each PATH of its tree main printed (read-only).  The image itself is
# the VM's out.img for the while (moved back after).
#   tools/gefsck IMG [PATH...]     exit 1 if the check fails
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
[ $# -ge 1 ] || { echo "usage: tools/gefsck IMG [PATH...]" >&2; exit 2; }
img=$1; shift
gefs=${GEFS:-$root/build/selfroot/amd64/bin/gefs}
[ -x "$gefs" ] || { echo "gefsck: no $gefs (tools/selfroot)" >&2; exit 1; }
b=$root/build
t=$(mktemp -d); rm -f "$b/in.img" "$b/out.img"
mkdir -p "$t/amd64/bin"; cp "$gefs" "$t/amd64/bin/gefs"
tar cf "$b/in.img" --format=ustar -C "$t" .; rm -rf "$t"
truncate -s 16M "$b/in.img"
mv "$img" "$b/out.img"
trap 'mv "$b/out.img" "$img"; "$here/vm" stop >/dev/null 2>&1 || true' EXIT
"$here/vm" start >/dev/null
printf 'term%% \t!done\n' | "$here/9run" -t 180 --dialog - >/dev/null
{
	echo 'g=/dev/sdE2/data'
	echo 'cd /tmp && tar xf /dev/sdE1/data ./amd64/bin/gefs'
	echo '/tmp/amd64/bin/gefs -c -f $g >/tmp/check.log >[2=1]; st=$status'
	echo "grep -v '^	' /tmp/check.log | tail -3"
	echo "~ \$st '' || exit check"
	if [ $# -gt 0 ]; then
		echo '/tmp/amd64/bin/gefs -R -A -n gk -f $g >[2]/dev/null && mount -c /srv/gk /n/gk || exit mount'
		for p in "$@"; do echo "cat /n/gk$p || exit read"; done
	fi
} | "$here/9run" -t "${GEFSCK_TIMEOUT:-600}" --script -

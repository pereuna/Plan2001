 // int connect(int socket, const struct sockaddr *address, socklen_t address_len);
+// Monolith: the page may only reach the Plan2001 VM's forwarded ports on
+// this machine's loopback (MONOLITH_ALLOW, default "17019 5670"), over TCP,
+// and may not bind or listen.  Anything else fails as refused.
+static int MonolithAllowed(const uint8_t *address, int len) {
+  const struct sockaddr_in *sin = (const struct sockaddr_in*)address;
+  if (len < (int)sizeof(struct sockaddr_in) || sin->sin_family != AF_INET) return 0;
+  if (ntohl(sin->sin_addr.s_addr) != INADDR_LOOPBACK) return 0;
+  const char *ports = getenv("MONOLITH_ALLOW");
+  if (!ports) ports = "17019 5670";
+  int port = ntohs(sin->sin_port);
+  for (const char *p = ports; *p; ) {
+    char *end;
+    long v = strtol(p, &end, 10);
+    if (end == p) { p++; continue; }
+    if (v == port) return 1;
+    p = end;
+  }
+  return 0;
+}
